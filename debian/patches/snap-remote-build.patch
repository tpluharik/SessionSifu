Description: Fix manually dispatched classic Snap builds
 Permit manual workflow builds from main, bundle the Python interpreter,
 which classic snaps cannot inherit from the core24 base, and stage the
 desktop file from outside the portable application source tree.
Author: Tomas Pluharik <tpluharik@gmail.com>
Forwarded: not-needed
Last-Update: 2026-08-25
--- a/.github/workflows/snapcraft-publish.yml
+++ b/.github/workflows/snapcraft-publish.yml
@@ -22,7 +22,9 @@ jobs:
           app_version=$(sed -n 's/^CURRENT_VERSION = "\([^"]*\)"/\1/p' app/sessionsifu)
           snap_version=$(sed -n 's/^version: "\([^"]*\)"/\1/p' snap/snapcraft.yaml)
           test "$snap_version" = "$app_version"
-          test "$GITHUB_REF_NAME" = "v$app_version"
+          if [ "$GITHUB_REF_TYPE" = "tag" ]; then
+            test "$GITHUB_REF_NAME" = "v$app_version"
+          fi
       - name: Build snap
         id: build
         uses: snapcore/action-build@3bdaa03e1ba6bf59a65f84a751d943d549a54e79 # v1
--- a/snap/snapcraft.yaml
+++ b/snap/snapcraft.yaml
@@ -25,7 +25,7 @@ apps:
   sessionsifu:
     command: bin/sessionsifu-portable
     common-id: org.gnome.SessionSifu
-    desktop: snap/gui/sessionsifu.desktop
+    desktop: usr/share/applications/sessionsifu.desktop
     environment:
       PYTHONPATH: $SNAP/lib/python3.12/site-packages:$SNAP/usr/lib/python3/dist-packages
       TESSDATA_PREFIX: $SNAP/usr/share/tesseract-ocr/5/tessdata
@@ -40,6 +40,13 @@ parts:
       - psutil==7.2.2
       - PySide6==6.11.2
     stage-packages:
+      # Classic snaps cannot use the interpreter from the core24 base. Bundle
+      # Python explicitly so the launcher and virtual environment are portable.
+      - libpython3.12-minimal
+      - libpython3.12-stdlib
+      - python3-minimal
+      - python3.12-minimal
+      - python3.12-venv
       - libdbus-1-3
       - libegl1
       - libgl1
@@ -65,3 +72,10 @@ parts:
       - tesseract-ocr-ces
       - tesseract-ocr-eng
       - wmctrl
+
+  desktop:
+    plugin: dump
+    source: snap/gui
+    organize:
+      sessionsifu.desktop: usr/share/applications/sessionsifu.desktop
