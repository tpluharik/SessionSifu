<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
    "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">

<node>
    <interface name="org.gnome.Shell.Extensions.SessionSifu.Control">
        <method name="Ping">
            <arg type="s" name="message" direction="out"/>
        </method>
        <method name="SaveSession">
            <arg type="s" name="session_name" direction="in"/>
            <arg type="s" name="message" direction="out"/>
        </method>
        <method name="RestoreSession">
            <arg type="s" name="session_name" direction="in"/>
            <arg type="s" name="message" direction="out"/>
        </method>
        <method name="PlanSession">
            <arg type="s" name="session_name" direction="in"/>
            <arg type="s" name="plan_json" direction="out"/>
        </method>
        <method name="RestoreSessionSelection">
            <arg type="s" name="session_name" direction="in"/>
            <arg type="as" name="application_keys" direction="in"/>
            <arg type="s" name="message" direction="out"/>
        </method>
        <method name="DeleteSession">
            <arg type="s" name="session_name" direction="in"/>
            <arg type="s" name="message" direction="out"/>
        </method>
        <method name="ListSessions">
            <arg type="s" name="sessions_json" direction="out"/>
        </method>
        <method name="ListHistory">
            <arg type="s" name="history_json" direction="out"/>
        </method>
        <method name="SaveHistoryNow">
            <arg type="s" name="message" direction="out"/>
        </method>
        <method name="RestoreHistory">
            <arg type="s" name="snapshot_name" direction="in"/>
            <arg type="s" name="message" direction="out"/>
        </method>
        <method name="PlanHistory">
            <arg type="s" name="snapshot_name" direction="in"/>
            <arg type="s" name="plan_json" direction="out"/>
        </method>
        <method name="RestoreHistorySelection">
            <arg type="s" name="snapshot_name" direction="in"/>
            <arg type="as" name="application_keys" direction="in"/>
            <arg type="s" name="message" direction="out"/>
        </method>
        <method name="ListRecall">
            <arg type="s" name="query" direction="in"/>
            <arg type="s" name="recall_json" direction="out"/>
        </method>
        <method name="CaptureRecallNow">
            <arg type="s" name="message" direction="out"/>
        </method>
        <method name="DeleteRecall">
            <arg type="s" name="message" direction="out"/>
        </method>
        <method name="OpenManager">
            <arg type="s" name="message" direction="out"/>
        </method>
        <method name="RestoreSelectedSession">
            <arg type="s" name="message" direction="out"/>
        </method>
        <method name="RestorePreviousSession">
            <!-- a{sv} stands for Map<String, Variant> -->
            <arg type="a{sv}" name="args" direction= "in"/>
            <arg type="s" name="message" direction="out"/>
        </method>
    </interface>
</node>
