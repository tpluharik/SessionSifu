# This file is part of SessionSifu

# Do NOT modify this file, which could be overridden or deleted by this extension.


[Desktop Entry]
Name=Restore the previous session at startup
Comment=Restore the previous session at startup
Icon=
Exec=bash -c 'sleep ${autostartDelay} && gdbus call --session --dest org.gnome.Shell.Extensions.SessionSifu --object-path /org/gnome/Shell/Extensions/SessionSifu --method org.gnome.Shell.Extensions.SessionSifu.Control.RestorePreviousSession "{}"'
Terminal=false
Type=Application
# This option does not work on my machine, so I use `sleep` instead ...
X-GNOME-Autostart-Delay=
