{
  "version": "@VERSION@",
  "channel": "stable",
  "issued_at": "@ISSUED_AT@",
  "expires_at": "@EXPIRES_AT@",
  "minimum_version": "2.5.0",
  "package_url": "https://raw.githubusercontent.com/tpluharik/SessionSifu/main/updates/sessionsifu_@VERSION@_all.deb",
  "sha256": "@SHA256@",
  "size": @SIZE@,
  "notes": "SessionSifu 3.5.23 leaves GNOME browser tabs and documents to browser-owned session recovery instead of reopening saved files as duplicate tabs. Starting apps are reused before GNOME's running list catches up. Browser window placement and normal editor file restoration remain available. Firefox settings and profiles are not changed. Update the GNOME integration and log out/in once to load the changes."
}
