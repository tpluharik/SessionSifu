{
  "version": "@VERSION@",
  "channel": "stable",
  "issued_at": "@ISSUED_AT@",
  "expires_at": "@EXPIRES_AT@",
  "minimum_version": "2.5.0",
  "package_url": "https://raw.githubusercontent.com/tpluharik/SessionSifu/main/updates/sessionsifu_@VERSION@_all.deb",
  "sha256": "@SHA256@",
  "size": @SIZE@,
  "notes": "SessionSifu 3.5.33 fixes GNOME LibreOffice document replay: per-window file ownership instead of historical process arguments, capture generations and durable manual-only recovery records, cross-queue/suite document deduplication, and deferred close cleanup. Original old records are privately archived and remain explicitly recoverable. Accepted document opens are distinguished from pending placement. Conservative native-operation pacing and shutdown protection are unchanged. Isolated tests do not establish native desktop stability."
}
