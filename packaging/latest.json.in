{
  "version": "@VERSION@",
  "channel": "stable",
  "issued_at": "@ISSUED_AT@",
  "expires_at": "@EXPIRES_AT@",
  "minimum_version": "2.5.0",
  "package_url": "https://raw.githubusercontent.com/tpluharik/SessionSifu/main/updates/sessionsifu_@VERSION@_all.deb",
  "sha256": "@SHA256@",
  "size": @SIZE@,
  "notes": "SessionSifu 3.5.9 makes Wayland restoration compositor-safe: application launches and window mutations are serialized and paced, stale crash-recovery records are bounded by the newest saved window count, geometry is clamped to the current monitor work area, focus is never forced across workspaces, and a crash-loop guard pauses repeated automatic restores."
}
