{
  "version": "@VERSION@",
  "channel": "stable",
  "issued_at": "@ISSUED_AT@",
  "expires_at": "@EXPIRES_AT@",
  "minimum_version": "2.5.0",
  "package_url": "https://raw.githubusercontent.com/tpluharik/SessionSifu/main/updates/sessionsifu_@VERSION@_all.deb",
  "sha256": "@SHA256@",
  "size": @SIZE@,
  "notes": "SessionSifu 3.5.22 suspends Recall screenshots during restoration and display changes, rejects destroyed window actors and invalid launch workspace indices, and guards late shutdown callbacks. Command fallback launches now share the compositor queue. Normal restoration and Recall remain available. These safeguards do not establish that the underlying GNOME/AMD teardown crash is resolved. Update the GNOME integration and log out/in once to load the changes."
}
