    def _update_clicked(self, _button) -> None:
        if self._installed_update is not None and self._installed_update.is_file():
            try:
                subprocess.Popen(
                    [
                        "/bin/sh",
                        "-c",
                        'sleep 1; exec "$1"',
                        "sessionsifu-restart",
                        str(self._installed_update),
                    ],
                    start_new_session=True,
                )
                self.get_application().quit()
            except OSError as error:
                self._message(f"Could not restart SessionSifu: {error}")
            return
        if self._available_update is not None:
            self._download_available_update()
            return
        self.update_button.set_sensitive(False)
        self.update_row.set_subtitle("Checking the SessionSifu GitHub repository…")

        def worker() -> None:
            try:
                manifest = fetch_update_manifest()
                GLib.idle_add(self._finish_update_check, manifest, None)
            except Exception as error:
                GLib.idle_add(self._finish_update_check, None, str(error))

        threading.Thread(target=worker, daemon=True).start()

    def _finish_update_check(self, manifest: dict | None, error: str | None) -> bool:
        self.update_button.set_sensitive(True)
        if error:
            self.update_row.set_subtitle(f"Update check failed: {error}")
            self.update_button.set_label("Try Again")
            self.update_button.remove_css_class("suggested-action")
            return GLib.SOURCE_REMOVE
        repair_modules = missing_user_payload_modules()
        if (
            repair_modules
            and version_tuple(manifest["version"]) == version_tuple(CURRENT_VERSION)
        ):
            self._available_update = manifest
            self.update_row.set_subtitle(
                "Repair verified package · missing " + ", ".join(repair_modules)
            )
            self.update_button.set_label("Download & Repair")
            self.update_button.add_css_class("suggested-action")
            return GLib.SOURCE_REMOVE
        if version_tuple(manifest["version"]) <= version_tuple(CURRENT_VERSION):
            self.update_row.set_subtitle(f"Version {CURRENT_VERSION} is current")
            self.update_button.set_label("Check Again")
            self.update_button.remove_css_class("suggested-action")
            return GLib.SOURCE_REMOVE

        self._available_update = manifest
        notes = manifest["notes"] or "A newer verified package is available."
        self.update_row.set_subtitle(f"Version {manifest['version']} available · {notes}")
        self.update_button.set_label("Download & Install")
        self.update_button.add_css_class("suggested-action")
        return GLib.SOURCE_REMOVE

    def _download_available_update(self) -> None:
        manifest = self._available_update
        self.update_button.set_sensitive(False)
        self.update_row.set_subtitle(f"Downloading and verifying version {manifest['version']}…")

        def worker() -> None:
            try:
                package = download_update(manifest)
                local_app = install_user_update(package, manifest["version"])
                GLib.idle_add(self._finish_update_download, local_app, None)
            except Exception as error:
                GLib.idle_add(self._finish_update_download, None, str(error))

        threading.Thread(target=worker, daemon=True).start()

    def _finish_update_download(self, local_app: Path | None, error: str | None) -> bool:
        self.update_button.set_sensitive(True)
        if error:
            self.update_row.set_subtitle(f"Update failed: {error}")
            self.update_button.set_label("Try Again")
            self._available_update = None
            self.update_button.remove_css_class("suggested-action")
            return GLib.SOURCE_REMOVE

        self._installed_update = local_app
        self._available_update = None
        self.update_row.set_subtitle(
            "Installed for this user; restart the app, then log out and back in once"
        )
        self.update_button.set_label("Restart SessionSifu")
        self._message("SessionSifu was updated without using the system package manager.")
        return GLib.SOURCE_REMOVE

    def refresh(self) -> None:
        for child in self._session_rows_widgets:
            self.sessions_group.remove(child)
        self._session_rows_widgets.clear()
        for child in self._history_rows_widgets:
            self.history_group.remove(child)
        self._history_rows_widgets.clear()

        ping_message = None
        try:
            ping_message = call("Ping")
        except GLib.Error:
            pass
        live = ping_message is not None
        integration_current = ping_message == f"SessionSifu {CURRENT_VERSION} is ready"

        state, _state_message = extension_state()
        integration_update = extension_needs_update()
        self.status_row.set_subtitle(
            "Update GNOME integration, then log out and back in" if integration_update else
            "An older integration is running; reload it to activate capture" if live and not integration_current else
            "Enabled and connected" if live else
            "Enabled; starting GNOME integration" if state == "enabled" else
            "Installed but not enabled" if state == "disabled" else
            "Installed; log out and back in once" if state == "pending" else
            "Ready to install for this login" if state == "missing" else
            "GNOME extension manager is unavailable"
        )
        self.status_icon.set_from_icon_name(
            "emblem-ok-symbolic" if live and integration_current else "dialog-warning-symbolic"
        )
        self.enable_button.set_visible(
            integration_update or (not live and state != "pending")
        )
        self.enable_button.set_label(
            "Update Integration" if integration_update else
            "Reload Integration" if live and not integration_current else
            "Install & Enable" if state == "missing" else "Enable"
        )
        self.enable_button.set_sensitive(state != "unavailable")

        history = self._history_rows() if live and integration_current else []
        if not history:
            row = Adw.ActionRow(
                title="No automatic snapshots yet" if integration_current else "Update the GNOME integration to start history",
                subtitle="The first snapshot is created shortly after login." if integration_current else "The snapshot engine runs inside GNOME Shell.",
            )
            self.history_group.add(row)
            self._history_rows_widgets.append(row)
        else:
            for item in history:
                modified = datetime.fromtimestamp(item.get("modified", 0)).strftime("%Y-%m-%d %H:%M:%S")
                row = Adw.ActionRow(title=f"Snapshot from {modified}")
                restore = Gtk.Button(label="Restore", valign=Gtk.Align.CENTER)
                restore.add_css_class("suggested-action")
                restore.connect("clicked", self._restore_history, item["name"])
                row.add_suffix(restore)
                self.history_group.add(row)
                self._history_rows_widgets.append(row)

        for child in self._recall_rows_widgets:
            self.recall_results_group.remove(child)
        self._recall_rows_widgets.clear()
        recall_entries = self._recall_rows() if live and integration_current else []
        if not self.recall_switch.get_active():
            recall_row = Adw.ActionRow(
                title="Privacy Recall capture is paused",
                subtitle="Existing history remains searchable and exclusions are still applied.",
            )
            self.recall_results_group.add(recall_row)
            self._recall_rows_widgets.append(recall_row)
        if not recall_entries:
            recall_row = Adw.ActionRow(
                title="No matching Recall entries",
                subtitle="No stored non-excluded activity matches this search.",
            )
            self.recall_results_group.add(recall_row)
            self._recall_rows_widgets.append(recall_row)
        else:
            for item in recall_entries:
                modified = datetime.fromtimestamp(item.get("modified", 0)).strftime("%Y-%m-%d %H:%M:%S")
                apps = ", ".join(item.get("apps", [])[:4]) or "Unknown application"
                titles = " · ".join(item.get("titles", [])[:3])
                recall_row = Adw.ActionRow(
                    title=f"{modified} — {apps}",
                    subtitle=titles or "No window title was exposed",
                )
                recall_row.add_prefix(recall_preview(item, width=144, height=82))
                self.recall_results_group.add(recall_row)
                self._recall_rows_widgets.append(recall_row)

        sessions = self._session_rows() if live else []
        if not sessions:
            row = Adw.ActionRow(
                title="No saved sessions yet" if live else "Enable the extension to manage sessions",
                subtitle="Arrange your desktop and save it with a name." if live else "A one-time logout/login may be required after installation.",
            )
            self.sessions_group.add(row)
            self._session_rows_widgets.append(row)
            return

        for item in sessions:
            modified = datetime.fromtimestamp(item.get("modified", 0)).strftime("%Y-%m-%d %H:%M")
            row = Adw.ActionRow(title=item["name"], subtitle=f"Saved {modified}")
            restore = Gtk.Button(label="Restore", valign=Gtk.Align.CENTER)
            restore.add_css_class("suggested-action")
            restore.connect("clicked", self._restore, item["name"])
            delete = Gtk.Button(icon_name="user-trash-symbolic", tooltip_text="Move to Trash", valign=Gtk.Align.CENTER)
            delete.connect("clicked", self._delete, item["name"])
            row.add_suffix(restore)
            row.add_suffix(delete)
            self.sessions_group.add(row)
            self._session_rows_widgets.append(row)


class SessionSifuApplication(Adw.Application):
    def __init__(self, recall_search: bool = False):
        self.recall_search = recall_search
        application_id = f"{APP_ID}.RecallSearch" if recall_search else APP_ID
        super().__init__(application_id=application_id, flags=Gio.ApplicationFlags.DEFAULT_FLAGS)

    def do_activate(self):
        window = self.get_active_window()
        if window is None:
            window = RecallSearchWindow(self) if self.recall_search else ManagerWindow(self)
        if self.recall_search:
            window.present_search()
        else:
            window.present()


def autostart() -> int:
    config = settings()
    if not config.get_boolean("enable-restore-previous-session"):
        return 0
    time.sleep(max(0, min(config.get_int("autostart-delay"), 60)))
    try:
        call("RestorePreviousSession", GLib.Variant("(a{sv})", ({"removeAfterRestore": GLib.Variant("b", False)},)), 15000)
        return 0
    except GLib.Error as error:
        print(f"sessionsifu: {error.message}", file=sys.stderr)
        return 1


def _archive_key(passphrase: str, salt: bytes) -> bytes:
    if len(passphrase) < 12:
        raise ValueError("Archive passphrase must contain at least 12 characters")
    return Scrypt(salt=salt, length=32, n=2**15, r=8, p=1).derive(
        passphrase.encode("utf-8")[:4096]
    )


def export_gnome_archive(destination: Path, passphrase: str) -> dict[str, int]:
    root = Path(GLib.get_user_config_dir()) / "sessionsifu"
    sessions = root / "sessions"
    payload = io.BytesIO()
    counts = {"session_files": 0, "recall": 0, "images": 0}
    with zipfile.ZipFile(payload, "w", compression=zipfile.ZIP_DEFLATED, compresslevel=6) as archive:
        archive.writestr("manifest.json", json.dumps({"format": 1, "application": "SessionSifu", "platform": "GNOME"}))
        if sessions.is_dir() and not sessions.is_symlink():
            for path in sessions.rglob("*"):
                if not path.is_file() or path.is_symlink() or path.stat().st_size > 16 * 1024 * 1024:
                    continue
                relative = path.relative_to(root)
                archive.writestr(f"session-files/{relative.as_posix()}", path.read_bytes())
                counts["session_files"] += 1
        for record, metadata, images in recall_vault().export_records():
            archive.writestr(f"recall/{record}.json", json.dumps(metadata, ensure_ascii=False))
            counts["recall"] += 1
            for index, image in enumerate(images):
                archive.writestr(f"recall/{record}--{index}.bin", image)
                counts["images"] += 1
        if payload.tell() > MAX_ARCHIVE_BYTES:
            raise ValueError("Export exceeds the archive safety limit")
    salt, nonce = os.urandom(16), os.urandom(12)
    encrypted = ARCHIVE_MAGIC + salt + nonce + AESGCM(_archive_key(passphrase, salt)).encrypt(
        nonce, payload.getvalue(), ARCHIVE_MAGIC
    )
    if len(encrypted) > MAX_ARCHIVE_BYTES:
        raise ValueError("Encrypted export exceeds the archive safety limit")
    destination = destination.expanduser()
    if destination.exists() and destination.is_symlink():
        raise ValueError("Refusing to overwrite a symbolic-link archive")
    destination.parent.mkdir(parents=True, exist_ok=True)
    descriptor, name = tempfile.mkstemp(prefix=".sessionsifu-export-", dir=destination.parent)
    temporary = Path(name)
    try:
        with os.fdopen(descriptor, "wb") as output:
            output.write(encrypted)
            output.flush()
            os.fsync(output.fileno())
        temporary.chmod(0o600)
        os.replace(temporary, destination)
        destination.chmod(0o600)
    finally:
        temporary.unlink(missing_ok=True)
    return counts


def import_gnome_archive(source: Path, passphrase: str) -> dict[str, int]:
    if source.is_symlink() or not source.is_file() or not 0 < source.stat().st_size <= MAX_ARCHIVE_BYTES:
        raise ValueError("Archive is not a bounded regular file")
    encrypted = source.read_bytes()
    if not encrypted.startswith(ARCHIVE_MAGIC) or len(encrypted) < 50:
        raise ValueError("Archive envelope is invalid")
    offset = len(ARCHIVE_MAGIC)
    salt, nonce = encrypted[offset:offset + 16], encrypted[offset + 16:offset + 28]
    try:
        raw = AESGCM(_archive_key(passphrase, salt)).decrypt(nonce, encrypted[offset + 28:], ARCHIVE_MAGIC)
    except Exception as error:
        raise ValueError("Archive passphrase is incorrect or the archive is damaged") from error
    root = Path(GLib.get_user_config_dir()) / "sessionsifu"
    sessions_root = root / "sessions"
    if sessions_root.is_symlink():
        raise ValueError("Refusing symbolic-link session storage")
    sessions_root.mkdir(parents=True, exist_ok=True, mode=0o700)
    imported_root = Path(tempfile.mkdtemp(prefix="Imported-", dir=sessions_root))
    imported_root.chmod(0o700)
    counts = {"session_files": 0, "recall": 0, "images": 0}
    with zipfile.ZipFile(io.BytesIO(raw), "r") as archive:
        members = archive.infolist()
        if len(members) > 40_000 or sum(member.file_size for member in members) > MAX_ARCHIVE_BYTES:
            raise ValueError("Archive expands beyond safety limits")
        manifest = json.loads(archive.read("manifest.json"))
        if manifest.get("format") != 1 or manifest.get("application") != "SessionSifu":
            raise ValueError("Archive format is unsupported")
        recall_metadata, recall_images = {}, {}
        for member in members:
            name = member.filename
            if member.is_dir() or member.file_size > 16 * 1024 * 1024:
                continue
            if name.startswith("session-files/sessions/"):
                relative = Path(name).relative_to("session-files/sessions")
                if not relative.parts or any(part in {"", ".", ".."} for part in relative.parts):
                    raise ValueError("Archive contains an unsafe session path")
                target = imported_root / relative
                target.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
                if target.is_symlink():
                    raise ValueError("Archive import target is a symbolic link")
                descriptor, temporary_name = tempfile.mkstemp(prefix=".import-", dir=target.parent)
                temporary = Path(temporary_name)
                try:
                    with os.fdopen(descriptor, "wb") as output:
                        output.write(archive.read(member))
                        output.flush()
                        os.fsync(output.fileno())
                    temporary.chmod(0o600)
                    os.replace(temporary, target)
                    target.chmod(0o600)
                finally:
                    temporary.unlink(missing_ok=True)
                counts["session_files"] += 1
            elif re.fullmatch(r"recall/recall-\d{8}-\d{6}-\d{3}\.json", name):
                recall_metadata[Path(name).stem] = json.loads(archive.read(member))
            elif re.fullmatch(r"recall/recall-\d{8}-\d{6}-\d{3}--\d+\.bin", name):
                stem, index = Path(name).name[:-4].rsplit("--", 1)
                recall_images.setdefault(stem, {})[int(index)] = archive.read(member)
                counts["images"] += 1
        vault = recall_vault()
        for stem, metadata in recall_metadata.items():
            images_by_index = recall_images.get(stem, {})
            images = [images_by_index[index] for index in sorted(images_by_index)]
            vault.import_record(metadata, images)
            counts["recall"] += 1
    return counts


def local_api_stdio() -> int:
    """Serve a read-only, pipe-only API without exposing a socket or vault key."""
    vault = recall_vault()
    config = settings()
    for line in sys.stdin:
        if len(line.encode("utf-8", "replace")) > 64 * 1024:
            response = {"ok": False, "error": "request is too large"}
        else:
            try:
                request = json.loads(line)
                if not isinstance(request, dict):
                    raise ValueError("request must be a JSON object")
                request_id = request.get("id")
                method = str(request.get("method") or "")[:64]
                params = request.get("params") or {}
                if not isinstance(params, dict):
                    raise ValueError("params must be a JSON object")
                if method == "status":
                    result = {
                        "version": CURRENT_VERSION,
                        "transport": "stdio",
                        "recall": vault.status(),
                        "capabilities": ["recall.search", "restore.preview"],
                    }
                elif method == "recall.search":
                    result = {
                        "results": vault.search(
                            str(params.get("query") or "")[:512],
                            app=str(params.get("application") or "")[:256],
                            semantic=bool(params.get("related")),
                            excluded_apps=tuple(config.get_strv("recall-excluded-apps")),
                            limit=100,
                        )
                    }
                    result["count"] = len(result["results"])
                elif method == "restore.preview":
                    name = str(params.get("name") or "")[:64]
                    if not NAME_RE.fullmatch(name):
                        raise ValueError("restore.preview requires a valid name")
                    result = json.loads(call("PlanSession", GLib.Variant("(s)", (name,))))
                else:
                    raise ValueError("unknown or write-capable method")
                response = {"ok": True, "result": result}
                if request_id is not None:
                    response["id"] = request_id
            except (GLib.Error, ValueError, TypeError, json.JSONDecodeError) as error:
                response = {"ok": False, "error": str(error)[:512]}
        print(json.dumps(response, ensure_ascii=False, separators=(",", ":")), flush=True)
    return 0


def mcp_stdio() -> int:
    """Serve the separately enabled, strictly read-only MCP surface."""
    from mcp import serve_mcp

    class GnomeReadOnlyController:
        version = CURRENT_VERSION

        def __init__(self) -> None:
            self.vault = recall_vault()
            self.config = settings()
            self.restore_journal = restore_journal_store()

        def search_recall(self, query="", *, app="", semantic=False, **_kwargs):
            return self.vault.search(
                query, app=app, semantic=semantic,
                excluded_apps=tuple(self.config.get_strv("recall-excluded-apps")),
            )

        def ask_recall(self, question):
            return self.vault.ask(question)

        @staticmethod
        def plan_named(name):
            if not NAME_RE.fullmatch(name):
                raise ValueError("restore.preview requires a valid name")
            return json.loads(call("PlanSession", GLib.Variant("(s)", (name,))))

        def diagnostics(self):
            return {
                "version": CURRENT_VERSION, "desktop": "GNOME",
                "recall": self.vault.diagnostics(),
                "restore_journals": len(self.restore_journal.list()),
                "transport": "stdio", "read_only": True,
            }

    return serve_mcp(GnomeReadOnlyController())


def main() -> int:
    parser = argparse.ArgumentParser(description="Save and restore GNOME desktop sessions")
    parser.add_argument("--autostart", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("--save", metavar="NAME")
    parser.add_argument("--restore", metavar="NAME")
    parser.add_argument("--list", action="store_true")
    parser.add_argument("--recall-search", action="store_true")
    parser.add_argument("--export-archive", type=Path, help="export encrypted sessions and Recall history")
    parser.add_argument("--import-archive", type=Path, help="import an encrypted SessionSifu archive")
    parser.add_argument("--recall-reindex", metavar="RECORD", help="re-run OCR for one Recall record")
    parser.add_argument("--recall-ask", metavar="QUESTION", help="ask local Recall history with citations")
    parser.add_argument("--capsule-create", metavar="NAME", help="create an encrypted workspace capsule")
    parser.add_argument(
        "--capsule-backend", choices=["profile", "flatpak", "windows-sandbox"],
        default="profile",
    )
    parser.add_argument("--capsule-app", action="append", default=[])
    parser.add_argument("--capsule-folder", action="append", default=[])
    parser.add_argument("--capsule-offline", action="store_true")
    parser.add_argument("--capsule-list", action="store_true")
    parser.add_argument("--capsule-plan", metavar="NAME")
    parser.add_argument("--capsule-launch", metavar="NAME")
    parser.add_argument("--capsule-delete", metavar="NAME")
    parser.add_argument("--capsule-delete-data", metavar="NAME")
    parser.add_argument("--capsule-export-wsb", metavar="NAME")
    parser.add_argument("--capsule-output", type=Path)
    parser.add_argument(
        "--local-api-stdio", action="store_true",
        help="serve the read-only local JSON API on stdin/stdout",
    )
    parser.add_argument(
        "--mcp-stdio", action="store_true",
        help="serve the opt-in read-only Model Context Protocol adapter",
    )
    parser.add_argument("--finalize-recall", metavar="CAPTURE", help=argparse.SUPPRESS)
    parser.add_argument(
        "--compress-recall-preview",
        nargs=2,
        metavar=("SOURCE", "OUTPUT_STEM"),
        help=argparse.SUPPRESS,
    )
    parser.add_argument("--display-layout", default="[]", help=argparse.SUPPRESS)
    parser.add_argument("--preview-quality", default="storage", help=argparse.SUPPRESS)
    parser.add_argument("--window-only", action="store_true", help=argparse.SUPPRESS)
    args = parser.parse_args()

    if args.compress_recall_preview:
        return compress_recall_preview(
            args.compress_recall_preview[0],
            args.compress_recall_preview[1],
            args.display_layout,
            args.preview_quality,
            window_only=args.window_only,
        )
    harden_local_storage()
    if args.local_api_stdio:
        return local_api_stdio()
    if args.mcp_stdio:
        return mcp_stdio()
    if args.finalize_recall:
        try:
            result = recall_vault().finalize(Path(args.finalize_recall), recall_policy(settings()))
            print(json.dumps(result, separators=(",", ":")))
            return 0
        except (OSError, RuntimeError, ValueError, json.JSONDecodeError) as error:
            print(f"sessionsifu: Recall finalization failed: {error}", file=sys.stderr)
            return 1
    if args.recall_reindex:
        print(json.dumps(recall_vault().reindex(args.recall_reindex), indent=2))
        return 0
    if args.recall_ask:
        print(json.dumps(recall_vault().ask(args.recall_ask), indent=2))
        return 0
    if args.capsule_create:
        print(workspace_capsules().create(
            args.capsule_create,
            args.capsule_backend,
            args.capsule_app,
            offline=args.capsule_offline,
            mapped_folders=args.capsule_folder,
        ))
        return 0
    if args.capsule_list:
        print(json.dumps([
            item.to_dict() for item in workspace_capsules().store.list()
        ], indent=2))
        return 0
    if args.capsule_plan:
        print(json.dumps(workspace_capsules().preflight(args.capsule_plan), indent=2))
        return 0
    if args.capsule_launch:
        print(json.dumps(workspace_capsules().launch(args.capsule_launch), indent=2))
        return 0
    if args.capsule_delete:
        workspace_capsules().store.delete(args.capsule_delete)
        return 0
    if args.capsule_delete_data:
        print(json.dumps({
            "deleted": workspace_capsules().store.delete_data(args.capsule_delete_data)
        }))
        return 0
    if args.capsule_export_wsb:
        if not args.capsule_output:
            parser.error("--capsule-output is required with --capsule-export-wsb")
        print(workspace_capsules().export_windows_sandbox(
            args.capsule_export_wsb, args.capsule_output
        ))
        return 0
    if args.export_archive:
        print(json.dumps(export_gnome_archive(args.export_archive, getpass.getpass("Archive passphrase: "))))
        return 0
    if args.import_archive:
        print(json.dumps(import_gnome_archive(args.import_archive, getpass.getpass("Archive passphrase: "))))
        return 0
    if args.autostart:
        return autostart()
    if args.save:
        print(call("SaveSession", GLib.Variant("(s)", (args.save,))))
        return 0
    if args.restore:
        print(call("RestoreSession", GLib.Variant("(s)", (args.restore,))))
        return 0
    if args.list:
        for item in json.loads(call("ListSessions")):
            print(item["name"])
        return 0

    app = SessionSifuApplication(recall_search=args.recall_search)
    return app.run([sys.argv[0]])


if __name__ == "__main__":
    raise SystemExit(main())
