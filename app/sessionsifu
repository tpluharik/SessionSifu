    def _set_recall_shortcut(self, accelerator: str) -> None:
        self._settings.set_strv(
            "recall-search-shortcut", [accelerator] if accelerator else []
        )
        sync_gnome_recall_shortcut(self._settings)
        self.recall_shortcut_label.set_accelerator(accelerator)

    def _capture_recall_shortcut(self, _button) -> None:
        dialog = Adw.Window(
            title="Set Recall Search Shortcut",
            transient_for=self,
            modal=True,
            default_width=440,
            default_height=210,
        )
        content = Gtk.Box(
            orientation=Gtk.Orientation.VERTICAL,
            spacing=18,
            margin_top=24,
            margin_bottom=24,
            margin_start=24,
            margin_end=24,
            focusable=True,
        )
        content.append(Gtk.Label(
            label="Press the new keyboard combination",
            css_classes=["title-2"],
        ))
        status = Gtk.Label(
            label="Use at least one modifier such as Ctrl, Alt, Shift or Super.",
            wrap=True,
        )
        content.append(status)
        buttons = Gtk.Box(
            orientation=Gtk.Orientation.HORIZONTAL,
            spacing=12,
            halign=Gtk.Align.CENTER,
        )
        cancel = Gtk.Button(label="Cancel")
        cancel.connect("clicked", lambda _widget: dialog.close())
        reset = Gtk.Button(label="Reset to Ctrl+Alt+Space")
        reset.connect(
            "clicked",
            lambda _widget: (self._set_recall_shortcut("<Control><Alt>space"), dialog.close()),
        )
        buttons.append(cancel)
        buttons.append(reset)
        content.append(buttons)
        dialog.set_content(content)

        modifiers_only = {
            Gdk.KEY_Control_L, Gdk.KEY_Control_R,
            Gdk.KEY_Shift_L, Gdk.KEY_Shift_R,
            Gdk.KEY_Alt_L, Gdk.KEY_Alt_R,
            Gdk.KEY_Meta_L, Gdk.KEY_Meta_R,
            Gdk.KEY_Super_L, Gdk.KEY_Super_R,
        }

        def capture(_controller, keyval, _keycode, state) -> bool:
            if keyval == Gdk.KEY_Escape:
                dialog.close()
                return True
            if keyval in modifiers_only:
                return True
            modifiers = state & Gtk.accelerator_get_default_mod_mask()
            if not modifiers or not Gtk.accelerator_valid(keyval, modifiers):
                status.set_label(
                    "That combination cannot be global. Hold Ctrl, Alt, Shift or Super and press another key."
                )
                status.add_css_class("error")
                return True
            accelerator = Gtk.accelerator_name(keyval, modifiers)
            self._set_recall_shortcut(accelerator)
            dialog.close()
            return True

        key_controller = Gtk.EventControllerKey.new()
        key_controller.connect("key-pressed", capture)
        content.add_controller(key_controller)
        dialog.present()
        content.grab_focus()

    def _open_recall_search(self, _button) -> None:
        try:
            Gio.Subprocess.new(
                [str(Path(__file__).resolve()), "--recall-search"],
                Gio.SubprocessFlags.NONE,
            )
        except GLib.Error as error:
            self._message(f"Could not open Recall search: {error.message}")

    def _recall_exclusions_changed(self, entry) -> None:
        values = [value.strip() for value in entry.get_text().split(",") if value.strip()]
        if not any(value.casefold() == "sessionsifu" for value in values):
            values.insert(0, "SessionSifu")
        self._settings.set_strv("recall-excluded-apps", values)

    def _purge_recall_app_exclusions(self, entry, _param=None) -> None:
        if entry.get_has_focus() and _param is not None:
            return
        vault = recall_vault()
        for value in self._settings.get_strv("recall-excluded-apps"):
            if value.casefold() != "sessionsifu":
                vault.delete(app=value)

    def _recall_websites_changed(self, entry) -> None:
        values = [
            value.strip().casefold().lstrip(".")
            for value in entry.get_text().split(",")
            if value.strip()
        ]
        self._settings.set_strv("recall-excluded-websites", values[:128])

    def _purge_recall_website_exclusions(self, entry, _param=None) -> None:
        if entry.get_has_focus() and _param is not None:
            return
        vault = recall_vault()
        for value in self._settings.get_strv("recall-excluded-websites"):
            vault.delete(website=value)

    def _recall_quota_changed(self, row, _param) -> None:
        selected = row.get_selected()
        if selected < len(self.recall_quota_values):
            self._settings.set_int("recall-storage-quota-mb", self.recall_quota_values[selected])

    def _pause_recall(self, _button, seconds: int) -> None:
        now = int(time.time())
        if seconds == -2:
            tomorrow = datetime.now().replace(hour=0, minute=0, second=0, microsecond=0) + timedelta(days=1)
            until = int(tomorrow.timestamp())
        elif seconds < 0:
            until = -1
        elif seconds == 0:
            until = 0
        else:
            until = now + seconds
        self._settings.set_int64("recall-pause-until", until)
        self._message("Privacy Recall resumed." if until == 0 else "Privacy Recall capture paused; existing history remains searchable.")
        self._refresh_recall_diagnostics()

    def _refresh_recall_diagnostics(self, *_args) -> None:
        status = recall_vault().status()
        state = str(status.get("state", "unknown"))
        duration = status.get("duration_ms")
        screenshots = status.get("screenshots", 0)
        size = float(status.get("vault_bytes", 0)) / (1024 * 1024)
        detail = f"{state} · {screenshots} preview(s) · {size:.1f} MiB · {status.get('encryption', 'unavailable')}"
        if duration is not None:
            detail += f" · {duration} ms"
        if status.get("reason"):
            detail += f" · {status['reason']}"
        self.recall_diagnostics_row.set_subtitle(detail)

    def _capture_recall(self, _button) -> None:
        if not self.recall_switch.get_active():
            self._message("Privacy Recall is disabled.")
            return
        if not live_extension_current():
            ok, message = enable_extension()
            if not ok or not live_extension_current():
                self._message(message)
                self.refresh()
                return
            self._message("GNOME integration reloaded; capturing the Recall snapshot now.")
        self._call("CaptureRecallNow")
        GLib.timeout_add(1400, self._refresh_once)

    def _search_recall(self, _widget) -> None:
        self.refresh()

    def _recall_rows(self) -> list[dict]:
        try:
            vault = recall_vault()
            policy = recall_policy(self._settings)
            vault.migrate_legacy(policy)
            return vault.search(
                self.recall_search_entry.get_text(),
                semantic=policy.semantic,
                excluded_apps=tuple(
                    self._settings.get_strv("recall-excluded-apps")
                ),
            )
        except (OSError, RuntimeError, ValueError):
            return []

    def _delete_recall(self, _button) -> None:
        dialog = Adw.AlertDialog(
            heading="Delete all Privacy Recall history?",
            body="All locally recorded Recall entries will be permanently deleted.",
        )
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("delete", "Delete All")
        dialog.set_response_appearance("delete", Adw.ResponseAppearance.DESTRUCTIVE)
        dialog.set_default_response("cancel")
        dialog.set_close_response("cancel")
        dialog.connect("response", self._delete_recall_response)
        dialog.present(self)

    def _delete_recall_response(self, _dialog, response: str) -> None:
        if response == "delete":
            recall_vault().delete()
            self._call("DeleteRecall")  # remove any capture still awaiting finalization
            self.refresh()

    def _snapshot_interval_changed(self, row, _param) -> None:
        selected = row.get_selected()
        if selected < len(self.snapshot_intervals):
            self._settings.set_int("continuous-save-interval", self.snapshot_intervals[selected])

    def _save_snapshot(self, _button) -> None:
        self._call("SaveHistoryNow")
        GLib.timeout_add(1400, self._refresh_once)

    def _restore_history(self, _button, name: str) -> None:
        self._call("RestoreHistory", GLib.Variant("(s)", (name,)))

    def _session_rows(self) -> list[dict]:
        try:
            return json.loads(call("ListSessions"))
        except (GLib.Error, json.JSONDecodeError):
            return []

    def _history_rows(self) -> list[dict]:
        try:
            return json.loads(call("ListHistory"))
        except (GLib.Error, json.JSONDecodeError):
            return []

    def _update_clicked(self, _button) -> None:
        if self._installed_update is not None and self._installed_update.is_file():
            try:
                subprocess.Popen(
                    [
                        "/bin/sh",
                        "-c",
                        'sleep 1; exec "$1"',
                        "sessionsifu-restart",
                        str(self._installed_update),
                    ],
                    start_new_session=True,
                )
                self.get_application().quit()
            except OSError as error:
                self._message(f"Could not restart SessionSifu: {error}")
            return
        if self._available_update is not None:
            self._download_available_update()
            return
        self.update_button.set_sensitive(False)
        self.update_row.set_subtitle("Checking the SessionSifu GitHub repository…")

        def worker() -> None:
            try:
                manifest = fetch_update_manifest()
                GLib.idle_add(self._finish_update_check, manifest, None)
            except Exception as error:
                GLib.idle_add(self._finish_update_check, None, str(error))

        threading.Thread(target=worker, daemon=True).start()

    def _finish_update_check(self, manifest: dict | None, error: str | None) -> bool:
        self.update_button.set_sensitive(True)
        if error:
            self.update_row.set_subtitle(f"Update check failed: {error}")
            self.update_button.set_label("Try Again")
            self.update_button.remove_css_class("suggested-action")
            return GLib.SOURCE_REMOVE
        if version_tuple(manifest["version"]) <= version_tuple(CURRENT_VERSION):
            self.update_row.set_subtitle(f"Version {CURRENT_VERSION} is current")
            self.update_button.set_label("Check Again")
            self.update_button.remove_css_class("suggested-action")
            return GLib.SOURCE_REMOVE

        self._available_update = manifest
        notes = manifest["notes"] or "A newer verified package is available."
        self.update_row.set_subtitle(f"Version {manifest['version']} available · {notes}")
        self.update_button.set_label("Download & Install")
        self.update_button.add_css_class("suggested-action")
        return GLib.SOURCE_REMOVE

    def _download_available_update(self) -> None:
        manifest = self._available_update
        self.update_button.set_sensitive(False)
        self.update_row.set_subtitle(f"Downloading and verifying version {manifest['version']}…")

        def worker() -> None:
            try:
                package = download_update(manifest)
                local_app = install_user_update(package, manifest["version"])
                GLib.idle_add(self._finish_update_download, local_app, None)
            except Exception as error:
                GLib.idle_add(self._finish_update_download, None, str(error))

        threading.Thread(target=worker, daemon=True).start()

    def _finish_update_download(self, local_app: Path | None, error: str | None) -> bool:
        self.update_button.set_sensitive(True)
        if error:
            self.update_row.set_subtitle(f"Update failed: {error}")
            self.update_button.set_label("Try Again")
            self._available_update = None
            self.update_button.remove_css_class("suggested-action")
            return GLib.SOURCE_REMOVE

        self._installed_update = local_app
        self._available_update = None
        self.update_row.set_subtitle(
            "Installed for this user; restart the app, then log out and back in once"
        )
        self.update_button.set_label("Restart SessionSifu")
        self._message("SessionSifu was updated without using the system package manager.")
        return GLib.SOURCE_REMOVE

    def refresh(self) -> None:
        for child in self._session_rows_widgets:
            self.sessions_group.remove(child)
        self._session_rows_widgets.clear()
        for child in self._history_rows_widgets:
            self.history_group.remove(child)
        self._history_rows_widgets.clear()

        ping_message = None
        try:
            ping_message = call("Ping")
        except GLib.Error:
            pass
        live = ping_message is not None
        integration_current = ping_message == f"SessionSifu {CURRENT_VERSION} is ready"

        state, _state_message = extension_state()
        integration_update = extension_needs_update()
        self.status_row.set_subtitle(
            "Update GNOME integration, then log out and back in" if integration_update else
            "An older integration is running; reload it to activate capture" if live and not integration_current else
            "Enabled and connected" if live else
            "Enabled; starting GNOME integration" if state == "enabled" else
            "Installed but not enabled" if state == "disabled" else
            "Installed; log out and back in once" if state == "pending" else
            "Ready to install for this login" if state == "missing" else
            "GNOME extension manager is unavailable"
        )
        self.status_icon.set_from_icon_name(
            "emblem-ok-symbolic" if live and integration_current else "dialog-warning-symbolic"
        )
        self.enable_button.set_visible(
            integration_update or (not live and state != "pending")
        )
        self.enable_button.set_label(
            "Update Integration" if integration_update else
            "Reload Integration" if live and not integration_current else
            "Install & Enable" if state == "missing" else "Enable"
        )
        self.enable_button.set_sensitive(state != "unavailable")

        history = self._history_rows() if live and integration_current else []
        if not history:
            row = Adw.ActionRow(
                title="No automatic snapshots yet" if integration_current else "Update the GNOME integration to start history",
                subtitle="The first snapshot is created shortly after login." if integration_current else "The snapshot engine runs inside GNOME Shell.",
            )
            self.history_group.add(row)
            self._history_rows_widgets.append(row)
        else:
            for item in history:
                modified = datetime.fromtimestamp(item.get("modified", 0)).strftime("%Y-%m-%d %H:%M:%S")
                row = Adw.ActionRow(title=f"Snapshot from {modified}")
                restore = Gtk.Button(label="Restore", valign=Gtk.Align.CENTER)
                restore.add_css_class("suggested-action")
                restore.connect("clicked", self._restore_history, item["name"])
                row.add_suffix(restore)
                self.history_group.add(row)
                self._history_rows_widgets.append(row)

        for child in self._recall_rows_widgets:
            self.recall_results_group.remove(child)
        self._recall_rows_widgets.clear()
        recall_entries = self._recall_rows() if live and integration_current else []
        if not self.recall_switch.get_active():
            recall_row = Adw.ActionRow(
                title="Privacy Recall capture is paused",
                subtitle="Existing history remains searchable and exclusions are still applied.",
            )
            self.recall_results_group.add(recall_row)
            self._recall_rows_widgets.append(recall_row)
        if not recall_entries:
            recall_row = Adw.ActionRow(
                title="No matching Recall entries",
                subtitle="No stored non-excluded activity matches this search.",
            )
            self.recall_results_group.add(recall_row)
            self._recall_rows_widgets.append(recall_row)
        else:
            for item in recall_entries:
                modified = datetime.fromtimestamp(item.get("modified", 0)).strftime("%Y-%m-%d %H:%M:%S")
                apps = ", ".join(item.get("apps", [])[:4]) or "Unknown application"
                titles = " · ".join(item.get("titles", [])[:3])
                recall_row = Adw.ActionRow(
                    title=f"{modified} — {apps}",
                    subtitle=titles or "No window title was exposed",
                )
                recall_row.add_prefix(recall_preview(item, width=144, height=82))
                self.recall_results_group.add(recall_row)
                self._recall_rows_widgets.append(recall_row)

        sessions = self._session_rows() if live else []
        if not sessions:
            row = Adw.ActionRow(
                title="No saved sessions yet" if live else "Enable the extension to manage sessions",
                subtitle="Arrange your desktop and save it with a name." if live else "A one-time logout/login may be required after installation.",
            )
            self.sessions_group.add(row)
            self._session_rows_widgets.append(row)
            return

        for item in sessions:
            modified = datetime.fromtimestamp(item.get("modified", 0)).strftime("%Y-%m-%d %H:%M")
            row = Adw.ActionRow(title=item["name"], subtitle=f"Saved {modified}")
            restore = Gtk.Button(label="Restore", valign=Gtk.Align.CENTER)
            restore.add_css_class("suggested-action")
            restore.connect("clicked", self._restore, item["name"])
            delete = Gtk.Button(icon_name="user-trash-symbolic", tooltip_text="Move to Trash", valign=Gtk.Align.CENTER)
            delete.connect("clicked", self._delete, item["name"])
            row.add_suffix(restore)
            row.add_suffix(delete)
            self.sessions_group.add(row)
            self._session_rows_widgets.append(row)


class SessionSifuApplication(Adw.Application):
    def __init__(self, recall_search: bool = False):
        self.recall_search = recall_search
        application_id = f"{APP_ID}.RecallSearch" if recall_search else APP_ID
        super().__init__(application_id=application_id, flags=Gio.ApplicationFlags.DEFAULT_FLAGS)

    def do_activate(self):
        window = self.get_active_window()
        if window is None:
            window = RecallSearchWindow(self) if self.recall_search else ManagerWindow(self)
        if self.recall_search:
            window.present_search()
        else:
            window.present()


def autostart() -> int:
    config = settings()
    if not config.get_boolean("enable-restore-previous-session"):
        return 0
    time.sleep(max(0, min(config.get_int("autostart-delay"), 60)))
    try:
        call("RestorePreviousSession", GLib.Variant("(a{sv})", ({"removeAfterRestore": GLib.Variant("b", False)},)), 15000)
        return 0
    except GLib.Error as error:
        print(f"sessionsifu: {error.message}", file=sys.stderr)
        return 1


def main() -> int:
    parser = argparse.ArgumentParser(description="Save and restore GNOME desktop sessions")
    parser.add_argument("--autostart", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("--save", metavar="NAME")
    parser.add_argument("--restore", metavar="NAME")
    parser.add_argument("--list", action="store_true")
    parser.add_argument("--recall-search", action="store_true")
    parser.add_argument("--finalize-recall", metavar="CAPTURE", help=argparse.SUPPRESS)
    parser.add_argument(
        "--compress-recall-preview",
        nargs=2,
        metavar=("SOURCE", "OUTPUT_STEM"),
        help=argparse.SUPPRESS,
    )
    parser.add_argument("--display-layout", default="[]", help=argparse.SUPPRESS)
    args = parser.parse_args()

    if args.compress_recall_preview:
        return compress_recall_preview(
            args.compress_recall_preview[0],
            args.compress_recall_preview[1],
            args.display_layout,
        )
    harden_local_storage()
    if args.finalize_recall:
        try:
            result = recall_vault().finalize(Path(args.finalize_recall), recall_policy(settings()))
            print(json.dumps(result, separators=(",", ":")))
            return 0
        except (OSError, RuntimeError, ValueError, json.JSONDecodeError) as error:
            print(f"sessionsifu: Recall finalization failed: {error}", file=sys.stderr)
            return 1
    if args.autostart:
        return autostart()
    if args.save:
        print(call("SaveSession", GLib.Variant("(s)", (args.save,))))
        return 0
    if args.restore:
        print(call("RestoreSession", GLib.Variant("(s)", (args.restore,))))
        return 0
    if args.list:
        for item in json.loads(call("ListSessions")):
            print(item["name"])
        return 0

    app = SessionSifuApplication(recall_search=args.recall_search)
    return app.run([sys.argv[0]])


if __name__ == "__main__":
    raise SystemExit(main())
