def harden_local_storage() -> None:
    """Migrate private SessionSifu state to owner-only permissions safely."""
    root = Path(GLib.get_user_config_dir()) / "sessionsifu"
    try:
        if not root.exists():
            return
        root_stat = root.lstat()
        if stat.S_ISLNK(root_stat.st_mode) or root_stat.st_uid != os.getuid():
            raise ValueError("Refusing unowned or symbolic-link SessionSifu storage")
        visited = 0
        for current, directories, files in os.walk(root, followlinks=False):
            current_path = Path(current)
            os.chmod(current_path, 0o700, follow_symlinks=False)
            for name in list(directories):
                candidate = current_path / name
                visited += 1
                candidate_stat = candidate.lstat()
                if (visited > 20_000):
                    raise ValueError("SessionSifu storage contains too many entries")
                if stat.S_ISLNK(candidate_stat.st_mode) or candidate_stat.st_uid != os.getuid():
                    directories.remove(name)
            for name in files:
                candidate = current_path / name
                visited += 1
                candidate_stat = candidate.lstat()
                if visited > 20_000:
                    raise ValueError("SessionSifu storage contains too many entries")
                if stat.S_ISREG(candidate_stat.st_mode) and candidate_stat.st_uid == os.getuid():
                    os.chmod(candidate, 0o600, follow_symlinks=False)
    except (OSError, ValueError) as error:
        print(f"sessionsifu: storage hardening warning: {error}", file=sys.stderr)


def recall_screenshot_path(value: object) -> Path | None:
    """Accept only private image previews from SessionSifu's Recall directory."""
    if not value:
        return None
    recall_dir = Path(GLib.get_user_config_dir()).resolve() / "sessionsifu" / "recall"
    candidate = Path(str(value))
    try:
        if candidate.is_symlink() or not candidate.is_file():
            return None
        resolved = candidate.resolve(strict=True)
        if resolved.parent != recall_dir or not RECALL_IMAGE_RE.fullmatch(resolved.name):
            return None
        size_limit = (
            MAX_RECALL_SOURCE_BYTES
            if resolved.suffix.casefold() == ".png"
            else MAX_RECALL_SCREENSHOT_BYTES
        )
        if resolved.stat().st_size <= 0 or resolved.stat().st_size > size_limit:
            return None
        return resolved
    except OSError:
        return None


@functools.lru_cache(maxsize=16)
def _recall_pixbuf(path: str, modified_ns: int, size: int) -> GdkPixbuf.Pixbuf:
    del modified_ns, size
    return GdkPixbuf.Pixbuf.new_from_file(path)


def _picture(path: Path, width: int, height: int, pixbuf=None) -> Gtk.Picture:
    if pixbuf is None:
        picture = Gtk.Picture.new_for_filename(str(path))
    else:
        picture = Gtk.Picture.new_for_paintable(Gdk.Texture.new_for_pixbuf(pixbuf))
    picture.set_content_fit(Gtk.ContentFit.COVER)
    picture.set_can_shrink(True)
    picture.set_size_request(width, height)
    return picture


def _draw_ocr_highlights(_area, context, width: int, height: int, state: dict) -> None:
    """Draw normalized OCR word boxes over a CONTAIN-fitted image."""
    pixbuf = state.get("pixbuf")
    boxes = state.get("boxes") or []
    if pixbuf is None or not boxes:
        return
    image_width = max(1, pixbuf.get_width())
    image_height = max(1, pixbuf.get_height())
    scale = min(width / image_width, height / image_height)
    rendered_width = image_width * scale
    rendered_height = image_height * scale
    offset_x = (width - rendered_width) / 2
    offset_y = (height - rendered_height) / 2
    context.set_line_width(max(1.5, min(width, height) / 220))
    active_index = int(state.get("active_index", 0))
    for box_index, box in enumerate(boxes[:64]):
        if not isinstance(box, dict):
            continue
        try:
            x = offset_x + float(box["x"]) * rendered_width / 10000
            y = offset_y + float(box["y"]) * rendered_height / 10000
            box_width = max(2, float(box["w"]) * rendered_width / 10000)
            box_height = max(2, float(box["h"]) * rendered_height / 10000)
        except (KeyError, TypeError, ValueError):
            continue
        context.rectangle(x, y, box_width, box_height)
        pulse = max(0.35, min(1.0, float(state.get("pulse", 1.0))))
        selected = box_index == active_index
        context.set_source_rgba(
            1.0, 0.78, 0.08,
            (0.28 + 0.28 * pulse) if selected else 0.18,
        )
        context.fill_preserve()
        context.set_source_rgba(
            1.0, 0.52, 0.0,
            (0.65 + 0.3 * pulse) if selected else 0.55,
        )
        context.stroke()


def _highlighted_picture(
    pixbuf: GdkPixbuf.Pixbuf,
    boxes: list[dict],
    width: int,
    height: int,
) -> Gtk.Widget:
    picture = _picture(Path("encrypted-highlighted-preview"), width, height, pixbuf)
    picture.set_content_fit(Gtk.ContentFit.CONTAIN)
    if not boxes:
        return picture
    overlay = Gtk.Overlay()
    overlay.set_size_request(width, height)
    overlay.set_child(picture)
    drawing = Gtk.DrawingArea()
    drawing.set_can_target(False)
    drawing.set_hexpand(True)
    drawing.set_vexpand(True)
    drawing.set_draw_func(
        _draw_ocr_highlights, {"pixbuf": pixbuf, "boxes": boxes}
    )
    overlay.add_overlay(drawing)
    return overlay


def _pixbuf_from_bytes(data: bytes) -> GdkPixbuf.Pixbuf | None:
    try:
        loader = GdkPixbuf.PixbufLoader.new()
        loader.write(data)
        loader.close()
        return loader.get_pixbuf()
    except GLib.Error:
        return None


def _matching_window_picture(
    item: dict, match: dict, width: int, height: int
) -> Gtk.Picture | None:
    displays = item.get("screenshots", [])
    display = next(
        (value for value in displays if value.get("index") == match.get("monitor")),
        None,
    )
    if display is None:
        return None
    path = recall_screenshot_path(display.get("path"))
    if path is None:
        return None
    try:
        stat = path.stat()
        pixbuf = _recall_pixbuf(str(path), stat.st_mtime_ns, stat.st_size)
        display_width = float(display["width"])
        display_height = float(display["height"])
        scale_x = pixbuf.get_width() / display_width
        scale_y = pixbuf.get_height() / display_height
        crop_x = round((float(match["x"]) - float(display["x"])) * scale_x)
        crop_y = round((float(match["y"]) - float(display["y"])) * scale_y)
        crop_width = round(float(match["width"]) * scale_x)
        crop_height = round(float(match["height"]) * scale_y)
        crop_x = max(0, min(crop_x, pixbuf.get_width() - 1))
        crop_y = max(0, min(crop_y, pixbuf.get_height() - 1))
        crop_width = max(1, min(crop_width, pixbuf.get_width() - crop_x))
        crop_height = max(1, min(crop_height, pixbuf.get_height() - crop_y))
        cropped = pixbuf.new_subpixbuf(crop_x, crop_y, crop_width, crop_height)
        return _picture(path, width, height, cropped)
    except (KeyError, OSError, TypeError, ValueError, GLib.Error):
        return None


def _window_pixbuf(item: dict) -> GdkPixbuf.Pixbuf | None:
    """Prefer a window image, with an encrypted display crop as fallback."""
    match = item.get("matched_window")
    if not isinstance(match, dict):
        return None
    try:
        window_image_index = int(match.get("image_index", -1))
    except (TypeError, ValueError):
        window_image_index = -1
    window_pixbuf = item.get("_pixbuf_by_index", {}).get(window_image_index)
    if window_pixbuf is not None:
        return window_pixbuf
    # A display crop contains the pixels of whichever windows were visible on
    # top at capture time. It is a useful approximation only for the focused
    # window; presenting it for another window can show unrelated content.
    if not bool(match.get("focused", False)):
        return None
    display = next(
        (
            value for value in item.get("displays", [])
            if isinstance(value, dict)
            and value.get("index") == match.get("monitor")
        ),
        None,
    )
    if display is None:
        return None
    try:
        image_index = int(display.get("image_index", -1))
        pixbuf = item.get("_pixbuf_by_index", {}).get(image_index)
        if pixbuf is None:
            return None
        display_width = float(display["width"])
        display_height = float(display["height"])
        if display_width <= 0 or display_height <= 0:
            return None
        scale_x = pixbuf.get_width() / display_width
        scale_y = pixbuf.get_height() / display_height
        crop_x = round((float(match["x"]) - float(display["x"])) * scale_x)
        crop_y = round((float(match["y"]) - float(display["y"])) * scale_y)
        crop_width = round(float(match["width"]) * scale_x)
        crop_height = round(float(match["height"]) * scale_y)
        crop_x = max(0, min(crop_x, pixbuf.get_width() - 1))
        crop_y = max(0, min(crop_y, pixbuf.get_height() - 1))
        crop_width = max(1, min(crop_width, pixbuf.get_width() - crop_x))
        crop_height = max(1, min(crop_height, pixbuf.get_height() - crop_y))
        return pixbuf.new_subpixbuf(crop_x, crop_y, crop_width, crop_height)
    except (KeyError, TypeError, ValueError, GLib.Error):
        return None


def recall_window_image_indices(item: dict) -> list[int]:
    """Return every linked window image, prioritizing the matched window."""
    try:
        image_count = max(0, int(item.get("image_count") or 0))
    except (TypeError, ValueError):
        image_count = 0
    indices: list[int] = []

    def append(value: object) -> None:
        try:
            index = int(value)
        except (TypeError, ValueError):
            return
        if 0 <= index < image_count and index not in indices:
            indices.append(index)

    match = item.get("matched_window")
    if isinstance(match, dict):
        append(match.get("image_index", -1))
    for window in item.get("windows", []):
        if isinstance(window, dict):
            append(window.get("image_index", -1))
    return indices


def recall_image_indices(item: dict) -> list[int]:
    """Order a snapshot gallery as windows, displays, then any legacy images."""
    try:
        image_count = max(0, int(item.get("image_count") or 0))
    except (TypeError, ValueError):
        image_count = 0
    indices = recall_window_image_indices(item)
    for display in item.get("displays", []):
        if not isinstance(display, dict):
            continue
        try:
            index = int(display.get("image_index", -1))
        except (TypeError, ValueError):
            continue
        if 0 <= index < image_count and index not in indices:
            indices.append(index)
    indices.extend(index for index in range(image_count) if index not in indices)
    return indices


def recall_highlight_image_index(item: dict) -> int:
    """Resolve the image whose OCR coordinates belong to a search result."""
    try:
        explicit = int(item.get("highlight_image_index", -1))
    except (TypeError, ValueError):
        explicit = -1
    if explicit >= 0:
        return explicit
    match = item.get("matched_window")
    if isinstance(match, dict):
        try:
            return int(match.get("image_index", -1))
        except (TypeError, ValueError):
            pass
    return -1


def recall_capture_summary(item: dict) -> str:
    """Describe whether a Recall moment contains every eligible window image."""
    diagnostics = item.get("capture_diagnostics")
    if not isinstance(diagnostics, dict):
        return "Capture completeness unavailable"
    try:
        captured = max(0, int(diagnostics.get("captured_window_images") or 0))
        eligible = max(0, int(
            diagnostics.get("eligible_windows", diagnostics.get("expected_windows", 0)) or 0
        ))
        protected = max(0, int(diagnostics.get("protected_windows") or 0))
        excluded = max(0, int(diagnostics.get("excluded_windows") or 0))
    except (TypeError, ValueError):
        return "Capture completeness unavailable"
    if eligible:
        summary = f"{captured}/{eligible} eligible window images"
    else:
        summary = "No eligible window images"
    withheld = protected + excluded
    if withheld:
        summary += f" · {withheld} privacy-filtered"
    if captured < eligible:
        summary += " · incomplete"
    return summary


def recall_preview(
    item: dict,
    width: int = 300,
    height: int = 170,
    show_all: bool = False,
) -> Gtk.Widget:
    pictures: list[Gtk.Picture] = []
    if not item.get("_pixbufs") and str(item.get("name", "")).endswith(".ssrec"):
        encrypted = []
        encrypted_by_index = {}
        indices = []
        try:
            highlighted_index = int(item.get("highlight_image_index", -1))
        except (TypeError, ValueError):
            highlighted_index = -1
        if 0 <= highlighted_index < int(item.get("image_count") or 0):
            indices.append(highlighted_index)
        indices.extend(range(min(
            8 if show_all else 2, int(item.get("image_count") or 0)
        )))
        match = item.get("matched_window")
        if isinstance(match, dict):
            try:
                window_index = int(match.get("image_index", -1))
            except (TypeError, ValueError):
                window_index = -1
            if 0 <= window_index < int(item.get("image_count") or 0):
                indices.append(window_index)
        for index in dict.fromkeys(indices):
            data = recall_vault().preview_bytes(str(item["name"]), index)
            pixbuf = _pixbuf_from_bytes(data) if data else None
            if pixbuf is not None:
                encrypted.append(pixbuf)
                encrypted_by_index[index] = pixbuf
        item["_pixbufs"] = encrypted
        item["_pixbuf_by_index"] = encrypted_by_index
    cropped = _window_pixbuf(item)
    if cropped is not None:
        return _highlighted_picture(
            cropped, item.get("highlight_boxes", []), width, height
        )
    try:
        highlighted_index = int(item.get("highlight_image_index", -1))
    except (TypeError, ValueError):
        highlighted_index = -1
    highlighted = item.get("_pixbuf_by_index", {}).get(highlighted_index)
    if highlighted is not None:
        return _highlighted_picture(
            highlighted, item.get("highlight_boxes", []), width, height
        )
    max_pictures = 8 if show_all else (1 if width < 220 else 2)
    candidate_count = min(
        max_pictures,
        len(item.get("matches", [])) or len(item.get("screenshots", [])) or 1,
    )
    columns = 1 if candidate_count == 1 else 2
    rows = max(1, (candidate_count + columns - 1) // columns)
    picture_width = max(1, width // columns)
    picture_height = max(1, height // rows)
    for pixbuf in item.get("_pixbufs", [])[:max_pictures]:
        pictures.append(_picture(Path("encrypted-preview"), picture_width, picture_height, pixbuf))
    for match in item.get("matches", [])[:max_pictures]:
        picture = _matching_window_picture(
            item, match, picture_width, picture_height
        )
        if picture is not None:
            pictures.append(picture)
    if not pictures:
        screenshot_values = item.get("screenshots", [])[:max_pictures]
        for screenshot in screenshot_values:
            path = recall_screenshot_path(screenshot.get("path"))
            if path is not None:
                pictures.append(_picture(path, picture_width, picture_height))
    if not pictures:
        path = recall_screenshot_path(item.get("screenshot"))
        if path is not None:
            pictures.append(_picture(path, width, height))
    if pictures:
        if len(pictures) == 1:
            pictures[0].set_size_request(width, height)
            return pictures[0]
        grid = Gtk.Grid(column_spacing=4, row_spacing=4)
        grid.set_size_request(width, height)
        for index, picture in enumerate(pictures):
            picture.set_hexpand(True)
            picture.set_vexpand(True)
            grid.attach(picture, index % columns, index // columns, 1, 1)
        return grid
    placeholder = Gtk.Box(
        orientation=Gtk.Orientation.VERTICAL,
        halign=Gtk.Align.CENTER,
        valign=Gtk.Align.CENTER,
        width_request=width,
        height_request=height,
    )
    placeholder.add_css_class("dim-label")
    placeholder.append(Gtk.Image(icon_name="image-missing-symbolic", pixel_size=42))
    placeholder.append(Gtk.Label(label="Preview skipped or unavailable"))
    return placeholder


def recall_preview_profile(value: str) -> tuple[int, int]:
    """Return the bounded longest edge and JPEG quality for a preference value."""
    return RECALL_PREVIEW_PROFILES.get(value, RECALL_PREVIEW_PROFILES["storage"])


def compress_recall_preview(
    source_value: str,
    stem_value: str,
    layout_value: str,
    quality_value: str = "storage",
    *,
    window_only: bool = False,
) -> int:
    """Compress bounded display and independently rendered window previews.

    When an excluded application is visible, ``window_only`` avoids creating a
    whole-desktop image while still encoding the individually rendered,
    non-excluded windows selected by the Shell integration.
    """
    configured_recall_dir = Path(GLib.get_user_config_dir()) / "sessionsifu" / "recall"
    source = Path(source_value)
    stem = Path(stem_value)
    temporary_paths: list[Path] = []
    raw_window_paths: list[Path] = []
    try:
        if configured_recall_dir.is_symlink():
            raise ValueError("Refusing symbolic-link Recall storage")
        recall_dir = configured_recall_dir.resolve()
        if source.parent.resolve() != recall_dir or stem.parent.resolve() != recall_dir:
            raise ValueError("Recall preview paths must remain in private Recall storage")
        if not RECALL_STEM_RE.fullmatch(stem.name):
            raise ValueError("Recall preview stem is invalid")
        raw_window_paths = sorted(
            recall_dir.glob(f"{stem.name}-window-*-raw.png")
        )[:MAX_RECALL_WINDOW_PREVIEWS]
        if source.name != f"{stem.name}-raw.png":
            raise ValueError("Recall screenshot source does not match its entry")
        normalized = []
        if not window_only:
            if source.is_symlink() or not source.is_file():
                raise ValueError("Recall screenshot source is not a regular file")
            source = source.resolve(strict=True)
            source_size = source.stat().st_size
            if source_size <= 0 or source_size > MAX_RECALL_SOURCE_BYTES:
                raise ValueError("Recall screenshot source is outside the size limit")
            displays = json.loads(layout_value)
            if not isinstance(displays, list) or not 1 <= len(displays) <= 8:
                raise ValueError("Recall display layout is invalid")
            for fallback_index, display in enumerate(displays):
                index = int(display.get("index", fallback_index))
                x, y = int(display["x"]), int(display["y"])
                display_width = int(display["width"])
                display_height = int(display["height"])
                if not 0 <= index < 8 or display_width <= 0 or display_height <= 0:
                    raise ValueError("Recall display geometry is invalid")
                normalized.append((index, x, y, display_width, display_height))

        preview_edge, jpeg_quality = recall_preview_profile(quality_value)

        def save_preview(
            cropped: GdkPixbuf.Pixbuf,
            target: Path,
            maximum_edge: int,
            quality: str,
        ) -> None:
            scale = min(
                1.0,
                maximum_edge / max(cropped.get_width(), cropped.get_height()),
            )
            if scale < 1.0:
                cropped = cropped.scale_simple(
                    max(1, round(cropped.get_width() * scale)),
                    max(1, round(cropped.get_height() * scale)),
                    GdkPixbuf.InterpType.BILINEAR,
                )
            if cropped.get_has_alpha():
                flattened = GdkPixbuf.Pixbuf.new(
                    GdkPixbuf.Colorspace.RGB,
                    False,
                    8,
                    cropped.get_width(),
                    cropped.get_height(),
                )
                flattened.fill(0xFFFFFFFF)
                cropped.composite(
                    flattened,
                    0,
                    0,
                    cropped.get_width(),
                    cropped.get_height(),
                    0,
                    0,
                    1,
                    1,
                    GdkPixbuf.InterpType.NEAREST,
                    255,
                )
                cropped = flattened
            temporary = target.with_name(f".{target.stem}.tmp")
            temporary_paths.append(temporary)
            cropped.savev(str(temporary), "jpeg", ["quality"], [quality])
            temporary.chmod(0o600)
            if not 0 < temporary.stat().st_size <= MAX_RECALL_SCREENSHOT_BYTES:
                raise ValueError("Compressed Recall preview exceeds the size limit")
            temporary.replace(target)

        if not window_only:
            pixbuf = GdkPixbuf.Pixbuf.new_from_file(str(source))
            if pixbuf.get_width() * pixbuf.get_height() > 150_000_000:
                raise ValueError("Recall screenshot dimensions are outside the safety limit")
            min_x = min(value[1] for value in normalized)
            min_y = min(value[2] for value in normalized)
            virtual_width = max(value[1] + value[3] for value in normalized) - min_x
            virtual_height = max(value[2] + value[4] for value in normalized) - min_y
            coordinate_scale_x = pixbuf.get_width() / virtual_width
            coordinate_scale_y = pixbuf.get_height() / virtual_height
            for index, x, y, display_width, display_height in normalized:
                crop_x = round((x - min_x) * coordinate_scale_x)
                crop_y = round((y - min_y) * coordinate_scale_y)
                crop_width = round(display_width * coordinate_scale_x)
                crop_height = round(display_height * coordinate_scale_y)
                crop_x = max(0, min(crop_x, pixbuf.get_width() - 1))
                crop_y = max(0, min(crop_y, pixbuf.get_height() - 1))
                crop_width = max(1, min(crop_width, pixbuf.get_width() - crop_x))
                crop_height = max(1, min(crop_height, pixbuf.get_height() - crop_y))
                cropped = pixbuf.new_subpixbuf(crop_x, crop_y, crop_width, crop_height)
                target = recall_dir / f"{stem.name}-display-{index}.jpg"
                save_preview(cropped, target, preview_edge, str(jpeg_quality))

        for raw_window in raw_window_paths:
            match = RECALL_RAW_WINDOW_RE.fullmatch(raw_window.name)
            if (
                not match
                or raw_window.is_symlink()
                or not raw_window.is_file()
                or not 0 < raw_window.stat().st_size <= MAX_RECALL_SOURCE_BYTES
            ):
                continue
            window_index = int(match.group(1))
            if not 0 <= window_index < MAX_RECALL_WINDOW_PREVIEWS:
                continue
            window_pixbuf = GdkPixbuf.Pixbuf.new_from_file(str(raw_window))
            if window_pixbuf.get_width() * window_pixbuf.get_height() > 50_000_000:
                continue
            save_preview(
                window_pixbuf,
                recall_dir / f"{stem.name}-window-{window_index}.jpg",
                preview_edge,
                str(max(60, jpeg_quality - 3)),
            )
        return 0
    except (GLib.Error, OSError, TypeError, ValueError, json.JSONDecodeError) as error:
        print(f"sessionsifu: could not compress Recall preview: {error}", file=sys.stderr)
        return 1
    finally:
        for temporary in temporary_paths:
            try:
                temporary.unlink(missing_ok=True)
            except OSError:
                pass
        if not window_only:
            try:
                source.unlink(missing_ok=True)
            except OSError:
                pass
        for raw_window in raw_window_paths:
            try:
                raw_window.unlink(missing_ok=True)
            except OSError:
                pass


def version_tuple(version: str) -> tuple[int, int, int]:
    match = re.fullmatch(r"v?(\d+)\.(\d+)\.(\d+)", version.strip())
    if not match:
        raise ValueError(f"Invalid SessionSifu version: {version}")
    return tuple(int(part) for part in match.groups())


def parse_update_manifest(contents: bytes | str) -> dict:
    if isinstance(contents, bytes):
        contents = contents.decode("utf-8")
    manifest = json.loads(contents)
    version_tuple(manifest["version"])
    package_url = urllib.parse.urlparse(manifest["package_url"])
    if (
        package_url.scheme != "https"
        or package_url.hostname != "raw.githubusercontent.com"
        or not package_url.path.startswith(UPDATE_REPOSITORY_PREFIX)
        or not package_url.path.endswith(".deb")
    ):
        raise ValueError("Update package must be stored in the SessionSifu GitHub repository")
    if not re.fullmatch(r"[0-9a-f]{64}", manifest["sha256"]):
        raise ValueError("Update manifest has an invalid SHA-256 digest")
    size = int(manifest["size"])
    if size <= 0 or size > MAX_UPDATE_BYTES:
        raise ValueError("Update package size is outside the allowed range")
    if manifest.get("channel") != "stable":
        raise ValueError("Update manifest has an invalid channel")
    issued_at = datetime.fromisoformat(str(manifest["issued_at"]).replace("Z", "+00:00"))
    expires_at = datetime.fromisoformat(str(manifest["expires_at"]).replace("Z", "+00:00"))
    now = datetime.now(timezone.utc)
    if issued_at.tzinfo is None or expires_at.tzinfo is None:
        raise ValueError("Update manifest timestamps must include a timezone")
    if issued_at > now + timedelta(hours=24) or expires_at <= now:
        raise ValueError("Update manifest is not currently valid")
    minimum_version = str(manifest["minimum_version"])
    version_tuple(minimum_version)
    if version_tuple(CURRENT_VERSION) < version_tuple(minimum_version):
        raise ValueError("This SessionSifu version cannot safely apply the update")
    return {
        "version": manifest["version"],
        "package_url": manifest["package_url"],
        "sha256": manifest["sha256"],
        "size": size,
        "notes": str(manifest.get("notes", "")),
        "channel": "stable",
        "issued_at": issued_at.isoformat(),
        "expires_at": expires_at.isoformat(),
        "minimum_version": minimum_version,
    }


def verify_update_manifest(contents: bytes, signature: bytes) -> None:
    if not contents or len(contents) > MAX_MANIFEST_BYTES:
        raise ValueError("Update manifest is outside the size limit")
    if not signature or len(signature) > MAX_SIGNATURE_BYTES:
        raise ValueError("Update signature is outside the size limit")
    with tempfile.TemporaryDirectory(prefix="sessionsifu-verify-") as directory:
        private_dir = Path(directory)
        private_dir.chmod(0o700)
        manifest_path = private_dir / "latest.json"
        signature_path = private_dir / "latest.json.sig"
        public_key_path = private_dir / "public.pem"
        manifest_path.write_bytes(contents)
        signature_path.write_bytes(signature)
        public_key_path.write_bytes(UPDATE_SIGNING_PUBLIC_KEY)
        result = subprocess.run(
            [
                "openssl", "pkeyutl", "-verify", "-pubin", "-inkey",
                str(public_key_path), "-rawin", "-in", str(manifest_path),
                "-sigfile", str(signature_path),
            ],
            check=False,
            capture_output=True,
            timeout=10,
        )
    if result.returncode != 0:
        raise ValueError("Update manifest signature verification failed")


def fetch_update_manifest(timeout: int = 8) -> dict:
    request = urllib.request.Request(
        UPDATE_MANIFEST_URL,
        headers={"User-Agent": f"SessionSifu/{CURRENT_VERSION}"},
    )
    with urllib.request.urlopen(request, timeout=timeout) as response:
        contents = response.read(MAX_MANIFEST_BYTES + 1)
    if len(contents) > MAX_MANIFEST_BYTES:
        raise ValueError("Update manifest is too large")
    signature_request = urllib.request.Request(
        UPDATE_SIGNATURE_URL,
        headers={"User-Agent": f"SessionSifu/{CURRENT_VERSION}"},
    )
    with urllib.request.urlopen(signature_request, timeout=timeout) as response:
        signature = response.read(MAX_SIGNATURE_BYTES + 1)
    verify_update_manifest(contents, signature)
    return parse_update_manifest(contents)


def download_update(manifest: dict, timeout: int = 20) -> Path:
    cache_dir = Path(GLib.get_user_cache_dir()) / "sessionsifu" / "updates"
    cache_dir.mkdir(parents=True, exist_ok=True)
    target = cache_dir / f"sessionsifu_{manifest['version']}_all.deb"
    temporary = target.with_suffix(".deb.part")
    request = urllib.request.Request(
        manifest["package_url"],
        headers={"User-Agent": f"SessionSifu/{CURRENT_VERSION}"},
    )
    digest = hashlib.sha256()
    received = 0
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            final_url = urllib.parse.urlparse(response.geturl())
            if (
                final_url.scheme != "https"
                or final_url.hostname != "raw.githubusercontent.com"
                or not final_url.path.startswith(UPDATE_REPOSITORY_PREFIX)
            ):
                raise ValueError("GitHub redirected the update to an untrusted location")
            with temporary.open("wb") as output:
                while chunk := response.read(64 * 1024):
                    received += len(chunk)
                    if received > MAX_UPDATE_BYTES:
                        raise ValueError("Update package exceeds the allowed size")
                    digest.update(chunk)
                    output.write(chunk)
        if received != manifest["size"]:
            raise ValueError("Downloaded update size does not match the manifest")
        if digest.hexdigest() != manifest["sha256"]:
            raise ValueError("Downloaded update failed SHA-256 verification")
        temporary.chmod(0o644)
        temporary.replace(target)
        return target
    except Exception:
        temporary.unlink(missing_ok=True)
        raise


def _atomic_copy(source: Path, target: Path, mode: int) -> None:
    target.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(dir=target.parent, delete=False) as output:
        temporary = Path(output.name)
        with source.open("rb") as input_file:
            shutil.copyfileobj(input_file, output)
    try:
        temporary.chmod(mode)
        os.replace(temporary, target)
    finally:
        temporary.unlink(missing_ok=True)


def _atomic_write_text(contents: str, target: Path, mode: int = 0o644) -> None:
    target.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(
        mode="w", encoding="utf-8", dir=target.parent, delete=False
    ) as output:
        output.write(contents)
        temporary = Path(output.name)
    try:
        temporary.chmod(mode)
        os.replace(temporary, target)
    finally:
        temporary.unlink(missing_ok=True)


def _desktop_quote(argument: str) -> str:
    escaped = argument.replace("\\", "\\\\")
    for character in ('"', "`", "$"):
        escaped = escaped.replace(character, f"\\{character}")
    return f'"{escaped}"'


def _replace_desktop_exec(contents: str, executable: Path, arguments: str = "") -> str:
    command = _desktop_quote(str(executable))
    if arguments:
        command = f"{command} {arguments}"
    lines = contents.splitlines()
    replaced = False
    for index, line in enumerate(lines):
        if line.startswith("Exec="):
            lines[index] = f"Exec={command}"
            replaced = True
            break
    if not replaced:
        raise ValueError("SessionSifu desktop entry has no Exec field")
    return "\n".join(lines) + "\n"


def _replace_directory_tree(source: Path, target: Path, label: str) -> None:
    if any(path.is_symlink() for path in source.rglob("*")):
        raise ValueError(f"Update {label} contains an unsupported symbolic link")
    target.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix=".sessionsifu-extension-", dir=target.parent) as temp:
        temporary_root = Path(temp)
        replacement = temporary_root / "replacement"
        backup = temporary_root / "previous"
        shutil.copytree(source, replacement)
        had_previous = target.exists()
        if had_previous:
            os.replace(target, backup)
        try:
            os.replace(replacement, target)
        except Exception:
            if had_previous and backup.exists() and not target.exists():
                os.replace(backup, target)
            raise


def install_user_payload(
    payload_root: Path,
    *,
    user_data_dir: Path | None = None,
    user_config_dir: Path | None = None,
    user_bin_dir: Path | None = None,
) -> Path:
    user_data_dir = user_data_dir or Path(GLib.get_user_data_dir())
    user_config_dir = user_config_dir or Path(GLib.get_user_config_dir())
    user_bin_dir = user_bin_dir or Path.home() / ".local" / "bin"

    source_app = payload_root / "usr/bin/sessionsifu"
    source_module_dir = payload_root / "usr/lib/sessionsifu"
    source_modules = {
        name: source_module_dir / name
        for name in (
            "recall_engine.py",
            "semantic.py",
            "restore_journal.py",
            "mcp.py",
            "capsule.py",
        )
    }
    source_desktop = payload_root / "usr/share/applications/org.gnome.SessionSifu.desktop"
    source_autostart = payload_root / "etc/xdg/autostart/org.gnome.SessionSifu.desktop"
    source_icon = payload_root / "usr/share/icons/hicolor/scalable/apps/org.gnome.SessionSifu.svg"
    source_extension = payload_root / "usr/share/gnome-shell/extensions" / UUID
    source_bundle = payload_root / "usr/share/sessionsifu/sessionsifu@local.shell-extension.zip"
    source_tessdata = payload_root / "usr/share/sessionsifu/tessdata"
    source_ocr_files = [
        source_tessdata / "ces.traineddata",
        source_tessdata / "eng.traineddata",
        source_tessdata / "configs/tsv",
        source_tessdata / "LICENSE",
    ]
    required_files = [
        source_app,
        *source_modules.values(),
        source_desktop,
        source_autostart,
        source_icon,
        source_bundle,
    ]
    if any(not path.is_file() or path.is_symlink() for path in required_files):
        raise ValueError("Update package is missing a required SessionSifu file")
    if not source_extension.is_dir() or source_extension.is_symlink():
        raise ValueError("Update package is missing the GNOME Shell extension")
    if any(not path.is_file() or path.is_symlink() for path in source_ocr_files):
        raise ValueError("Update package is missing bundled Czech OCR data")

    local_app = user_bin_dir / "sessionsifu"
    installed_app_dir = user_data_dir / "sessionsifu/app"
    installed_app = installed_app_dir / "sessionsifu"
    # Install dependencies before atomically activating the new launcher. This
    # prevents a partially applied update from leaving an unstartable app.
    for name, source_module in source_modules.items():
        _atomic_copy(source_module, installed_app_dir / name, 0o644)
    _atomic_write_text(
        _replace_desktop_exec(source_desktop.read_text(), local_app),
        user_data_dir / "applications/org.gnome.SessionSifu.desktop",
    )
    _atomic_write_text(
        _replace_desktop_exec(source_autostart.read_text(), local_app, "--autostart"),
        user_config_dir / "autostart/org.gnome.SessionSifu.desktop",
    )
    _atomic_copy(
        source_icon,
        user_data_dir / "icons/hicolor/scalable/apps/org.gnome.SessionSifu.svg",
        0o644,
    )
    _atomic_copy(
        source_bundle,
        user_data_dir / "sessionsifu/sessionsifu@local.shell-extension.zip",
        0o644,
    )
    _replace_directory_tree(
        source_extension,
        user_data_dir / "gnome-shell/extensions" / UUID,
        "extension",
    )
    _replace_directory_tree(
        source_tessdata,
        user_data_dir / "sessionsifu/tessdata",
        "OCR data",
    )
    _atomic_copy(source_app, installed_app, 0o755)
    _atomic_write_text(
        f"#!/bin/sh\nexec {shlex.quote(str(installed_app))} \"$@\"\n",
        local_app,
        0o755,
    )
    return local_app


def install_user_update(package: Path, expected_version: str) -> Path:
    version_result = subprocess.run(
        ["dpkg-deb", "--field", str(package), "Version"],
        check=False,
        capture_output=True,
        text=True,
        timeout=10,
    )
    package_version = version_result.stdout.strip()
    if version_result.returncode != 0 or package_version != expected_version:
        raise ValueError("Downloaded package version does not match the update manifest")

    cache_dir = Path(GLib.get_user_cache_dir()) / "sessionsifu" / "updates"
    cache_dir.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix="payload-", dir=cache_dir) as directory:
        payload_root = Path(directory)
        result = subprocess.run(
            ["dpkg-deb", "--extract", str(package), str(payload_root)],
            check=False,
            capture_output=True,
            text=True,
            timeout=30,
        )
        if result.returncode != 0:
            raise ValueError(result.stderr.strip() or "Could not extract the verified update")
        payload_app = payload_root / "usr/bin/sessionsifu"
        payload_metadata = (
            payload_root
            / "usr/share/gnome-shell/extensions"
            / UUID
            / "metadata.json"
        )
        try:
            metadata_version = str(json.loads(payload_metadata.read_text())["version-name"])
            app_version_matches = (
                f'CURRENT_VERSION = "{expected_version}"' in payload_app.read_text()
            )
        except (OSError, KeyError, TypeError, json.JSONDecodeError):
            metadata_version = ""
            app_version_matches = False
        if metadata_version != expected_version or not app_version_matches:
            raise ValueError("Update payload versions do not match the update manifest")
        local_app = install_user_payload(payload_root)
    schedule_extension_enable()
    return local_app


def _schema() -> Gio.SettingsSchema:
    """Find the schema without letting GLib abort on a missing global entry."""
    default_source = Gio.SettingsSchemaSource.get_default()
    override = os.environ.get("SESSIONSIFU_SCHEMA_DIR")
    source_path = Path(__file__).resolve()
    candidates = [
        Path(override) if override else None,
        Path(GLib.get_user_data_dir()) / "gnome-shell" / "extensions" / UUID / "schemas",
        Path("/usr/share/gnome-shell/extensions") / UUID / "schemas",
        source_path.parent.parent / "extension" / UUID / "schemas",
    ]

    for directory in candidates:
        if directory is None or not (directory / "gschemas.compiled").is_file():
            continue
        try:
            source = Gio.SettingsSchemaSource.new_from_directory(
                str(directory), default_source, False
            )
        except GLib.Error:
            continue
        schema = source.lookup(SCHEMA_ID, False)
        if schema is not None:
            return schema

    if default_source is not None:
        schema = default_source.lookup(SCHEMA_ID, True)
        if schema is not None:
            return schema

    raise RuntimeError(
        f"Settings schema {SCHEMA_ID} is unavailable; reinstall the SessionSifu package."
    )


def settings() -> Gio.Settings:
    return Gio.Settings.new_full(_schema(), None, None)


def sync_gnome_recall_shortcut(config: Gio.Settings) -> bool:
    """Install the accelerator through GNOME's native Custom Shortcuts service."""
    try:
        accelerators = config.get_strv("recall-search-shortcut")
        accelerator = next(
            (value for value in accelerators if value and value != "disabled"), ""
        )
        enabled = config.get_boolean("recall-search-shortcut-enabled") and bool(
            accelerator
        )
        media_keys = Gio.Settings.new(MEDIA_KEYS_SCHEMA)
        paths = list(media_keys.get_strv("custom-keybindings"))
        shortcut = Gio.Settings.new_with_path(
            CUSTOM_KEYBINDING_SCHEMA, RECALL_SHORTCUT_PATH
        )
        if enabled:
            if RECALL_SHORTCUT_PATH not in paths:
                media_keys.set_strv(
                    "custom-keybindings", [*paths, RECALL_SHORTCUT_PATH]
                )
            shortcut.set_string("name", "SessionSifu Recall Search")
            shortcut.set_string(
                "command", f"{shlex.quote(str(Path(__file__).resolve()))} --recall-search"
            )
            shortcut.set_string("binding", accelerator)
        else:
            if RECALL_SHORTCUT_PATH in paths:
                media_keys.set_strv(
                    "custom-keybindings",
                    [path for path in paths if path != RECALL_SHORTCUT_PATH],
                )
            shortcut.set_string("binding", "")
            shortcut.set_string("command", "")
        Gio.Settings.sync()
        return enabled
    except (GLib.Error, RuntimeError):
        return False


def shell_settings() -> Gio.Settings:
    return Gio.Settings.new("org.gnome.shell")


def schedule_extension_enable() -> None:
    config = shell_settings()
    enabled = list(config.get_strv("enabled-extensions"))
    disabled = list(config.get_strv("disabled-extensions"))
    if UUID not in enabled:
        enabled.append(UUID)
        config.set_strv("enabled-extensions", enabled)
    if UUID in disabled:
        config.set_strv("disabled-extensions", [item for item in disabled if item != UUID])
    Gio.Settings.sync()


def extension_scheduled() -> bool:
    return UUID in shell_settings().get_strv("enabled-extensions")


def proxy(timeout: int = 2000) -> Gio.DBusProxy:
    result = Gio.DBusProxy.new_for_bus_sync(
        Gio.BusType.SESSION,
        Gio.DBusProxyFlags.NONE,
        None,
        DBUS_NAME,
        DBUS_PATH,
        DBUS_IFACE,
        None,
    )
    result.set_default_timeout(timeout)
    return result


def call(method: str, parameters: GLib.Variant | None = None, timeout: int = 5000):
    return proxy(timeout).call_sync(
        method,
        parameters,
        Gio.DBusCallFlags.NONE,
        timeout,
        None,
    ).unpack()[0]


def extension_state() -> tuple[str, str]:
    try:
        completed = subprocess.run(
            ["gnome-extensions", "info", UUID],
            check=False,
            capture_output=True,
            text=True,
        )
    except OSError as error:
        return "unavailable", str(error)

    message = (completed.stderr or completed.stdout).strip()
    if completed.returncode != 0:
        return ("pending" if extension_scheduled() else "missing"), message
    if "STATE: ENABLED" in completed.stdout.upper():
        return "enabled", message
    return "disabled", message


def extension_bundle() -> Path | None:
    override = os.environ.get("SESSIONSIFU_EXTENSION_BUNDLE")
    candidates = [
        Path(override) if override else None,
        Path(GLib.get_user_data_dir()) / "sessionsifu" / "sessionsifu@local.shell-extension.zip",
        Path("/usr/share/sessionsifu/sessionsifu@local.shell-extension.zip"),
    ]
    return next((path for path in candidates if path is not None and path.is_file()), None)


def user_extension_version() -> str | None:
    metadata_path = (
        Path(GLib.get_user_data_dir())
        / "gnome-shell"
        / "extensions"
        / UUID
        / "metadata.json"
    )
    try:
        return str(json.loads(metadata_path.read_text())["version-name"])
    except (OSError, KeyError, TypeError, json.JSONDecodeError):
        return None


def extension_needs_update() -> bool:
    installed = user_extension_version()
    if installed is None:
        return False
    try:
        return version_tuple(installed) < version_tuple(CURRENT_VERSION)
    except ValueError:
        return True


def live_extension_current(timeout: int = 700) -> bool:
    """Return whether GNOME Shell is running this manager's extension API."""
    try:
        return call("Ping", timeout=timeout) == f"SessionSifu {CURRENT_VERSION} is ready"
    except GLib.Error:
        return False


def reload_extension() -> tuple[bool, str]:
    """Reload the user extension without restarting the Wayland session."""
    try:
        disabled = subprocess.run(
            ["gnome-extensions", "disable", UUID],
            check=False,
            capture_output=True,
            text=True,
            timeout=10,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        schedule_extension_enable()
        return False, f"Could not stop the old GNOME integration: {error}"
    if disabled.returncode != 0:
        message = (disabled.stderr or disabled.stdout).strip()
        schedule_extension_enable()
        return False, message or "Could not stop the old GNOME integration. Log out and back in once."

    # GNOME Shell applies extension state changes asynchronously. Giving the
    # disable request a short head start avoids racing the following enable.
    time.sleep(0.25)
    try:
        enabled = subprocess.run(
            ["gnome-extensions", "enable", UUID],
            check=False,
            capture_output=True,
            text=True,
            timeout=10,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        schedule_extension_enable()
        return False, f"Could not reload GNOME integration: {error}"
    if enabled.returncode != 0:
        message = (enabled.stderr or enabled.stdout).strip()
        schedule_extension_enable()
        return False, message or "Could not reload GNOME integration. Log out and back in once."

    for _attempt in range(10):
        if live_extension_current(400):
            return True, "GNOME integration reloaded and connected."
        time.sleep(0.15)

    schedule_extension_enable()
    return False, "GNOME accepted the reload but has not connected yet. Log out and back in once if it does not appear."


def enable_extension() -> tuple[bool, str]:
    state, state_message = extension_state()
    installed = False
    updating = extension_needs_update()
    if state == "unavailable":
        return False, state_message
    if state == "pending" and not updating:
        return True, "Extension is ready. Log out and back in once to start it."
    if state == "missing" or updating:
        bundle = extension_bundle()
        if bundle is None:
            return False, "The bundled GNOME Shell extension is missing; reinstall SessionSifu."
        completed = subprocess.run(
            ["gnome-extensions", "install", "--force", str(bundle)],
            check=False,
            capture_output=True,
            text=True,
        )
        if completed.returncode != 0:
            message = (completed.stderr or completed.stdout).strip()
            return False, message or "Could not install the GNOME Shell extension."
        installed = True
        if updating and state == "enabled":
            reloaded, message = reload_extension()
            return reloaded, (
                "GNOME integration updated and reloaded."
                if reloaded else message
            )

    # Re-running `gnome-extensions enable` does not reload an already enabled
    # extension. Explicitly cycle it when the on-disk version and live D-Bus API
    # disagree, which is the normal state immediately after an upgrade.
    if state == "enabled" and not installed:
        if live_extension_current():
            return True, "Extension is already enabled and connected."
        return reload_extension()

    completed = subprocess.run(
        ["gnome-extensions", "enable", UUID],
        check=False,
        capture_output=True,
        text=True,
    )
    message = (completed.stderr or completed.stdout).strip()
    if completed.returncode != 0:
        if installed:
            schedule_extension_enable()
            return True, "Extension installed. Log out and back in once to start it."
        return False, message
    return True, "Extension installed and enabled." if installed else "Extension enabled."


def tree_model_row_count(model: Gtk.TreeModel) -> int:
    """Return rows for GTK tree models (which are not Gio list models)."""
    return int(model.iter_n_children(None))


