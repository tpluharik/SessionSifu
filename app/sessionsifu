            "recall-search-shortcut-enabled", row.get_active()
        )
        sync_gnome_recall_shortcut(self._settings)
        self._update_recall_controls()

    def _set_recall_shortcut(self, accelerator: str) -> None:
        self._settings.set_strv(
            "recall-search-shortcut", [accelerator] if accelerator else []
        )
        sync_gnome_recall_shortcut(self._settings)
        self.recall_shortcut_label.set_accelerator(accelerator)

    def _capture_recall_shortcut(self, _button) -> None:
        dialog = Adw.Window(
            title="Set Recall Search Shortcut",
            transient_for=self,
            modal=True,
            default_width=440,
            default_height=210,
        )
        content = Gtk.Box(
            orientation=Gtk.Orientation.VERTICAL,
            spacing=18,
            margin_top=24,
            margin_bottom=24,
            margin_start=24,
            margin_end=24,
            focusable=True,
        )
        content.append(Gtk.Label(
            label="Press the new keyboard combination",
            css_classes=["title-2"],
        ))
        status = Gtk.Label(
            label="Use at least one modifier such as Ctrl, Alt, Shift or Super.",
            wrap=True,
        )
        content.append(status)
        buttons = Gtk.Box(
            orientation=Gtk.Orientation.HORIZONTAL,
            spacing=12,
            halign=Gtk.Align.CENTER,
        )
        cancel = Gtk.Button(label="Cancel")
        cancel.connect("clicked", lambda _widget: dialog.close())
        reset = Gtk.Button(label="Reset to Ctrl+Alt+Space")
        reset.connect(
            "clicked",
            lambda _widget: (self._set_recall_shortcut("<Control><Alt>space"), dialog.close()),
        )
        buttons.append(cancel)
        buttons.append(reset)
        content.append(buttons)
        dialog.set_content(content)

        modifiers_only = {
            Gdk.KEY_Control_L, Gdk.KEY_Control_R,
            Gdk.KEY_Shift_L, Gdk.KEY_Shift_R,
            Gdk.KEY_Alt_L, Gdk.KEY_Alt_R,
            Gdk.KEY_Meta_L, Gdk.KEY_Meta_R,
            Gdk.KEY_Super_L, Gdk.KEY_Super_R,
        }

        def capture(_controller, keyval, _keycode, state) -> bool:
            if keyval == Gdk.KEY_Escape:
                dialog.close()
                return True
            if keyval in modifiers_only:
                return True
            modifiers = state & Gtk.accelerator_get_default_mod_mask()
            if not modifiers or not Gtk.accelerator_valid(keyval, modifiers):
                status.set_label(
                    "That combination cannot be global. Hold Ctrl, Alt, Shift or Super and press another key."
                )
                status.add_css_class("error")
                return True
            accelerator = Gtk.accelerator_name(keyval, modifiers)
            self._set_recall_shortcut(accelerator)
            dialog.close()
            return True

        key_controller = Gtk.EventControllerKey.new()
        key_controller.connect("key-pressed", capture)
        content.add_controller(key_controller)
        dialog.present()
        content.grab_focus()

    def _open_recall_search(self, _button) -> None:
        try:
            Gio.Subprocess.new(
