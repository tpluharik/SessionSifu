    def _message(self, text: str) -> None:
        self.banner.set_title(text)
        self.banner.set_revealed(True)

    def _capsule_values(self) -> tuple[str, str, list[str], list[str], bool]:
        name = self.capsule_name_entry.get_text().strip()
        backend = ("profile", "flatpak", "windows-sandbox")[
            min(self.capsule_backend_row.get_selected(), 2)
        ]
        applications = [
            value.strip()
            for value in self.capsule_apps_entry.get_text().split(",")
            if value.strip()
        ]
        folders = [
            value.strip()
            for value in self.capsule_folders_entry.get_text().split(",")
            if value.strip()
        ]
        return (
            name,
            backend,
            applications,
            folders,
            self.capsule_offline_switch.get_active(),
        )

    def _save_capsule(self, _button) -> None:
        name, backend, applications, folders, offline = self._capsule_values()
        try:
            workspace_capsules().create(
                name, backend, applications, offline=offline, mapped_folders=folders
            )
            self._message(f"Encrypted workspace capsule ‘{name}’ was saved.")
        except (OSError, RuntimeError, ValueError) as error:
            self._message(f"Could not save capsule: {error}")

    def _review_capsule(self, _button) -> None:
        name = self.capsule_name_entry.get_text().strip()
        try:
            plan = workspace_capsules().preflight(name)
            permissions = plan.get("effective_permissions", {})
            details = "; ".join(
                f"{key}: {value}" for key, value in permissions.items()
            )
            errors = "; ".join(plan.get("errors", []))
            self._message(
                f"{plan['boundary']} · {details}"
                + (f" · blocked: {errors}" if errors else " · ready to launch")
            )
        except (OSError, RuntimeError, ValueError) as error:
            self._message(f"Could not review capsule: {error}")

    def _launch_capsule(self, _button) -> None:
        name = self.capsule_name_entry.get_text().strip()
        try:
            result = workspace_capsules().launch(name)
            self._message(
                f"Launched {result['launched']} application(s) through "
                f"{result['boundary']}."
            )
        except (OSError, RuntimeError, ValueError) as error:
            self._message(f"Capsule launch was blocked: {error}")

    def _delete_capsule_data(self, _button) -> None:
        name = self.capsule_name_entry.get_text().strip()
        try:
            deleted = workspace_capsules().store.delete_data(name)
            self._message(
                "Separate profile data was deleted."
                if deleted else "This capsule has no separate profile data."
            )
        except (OSError, ValueError) as error:
            self._message(f"Could not delete capsule data: {error}")

    def _call(self, method: str, parameters: GLib.Variant | None = None) -> str | None:
        try:
            result = call(method, parameters)
            self._message(result)
            return result
        except GLib.Error as error:
            if "UnknownMethod" in error.message:
                self._message(
                    "GNOME Shell is still running an older SessionSifu integration. "
                    "Use Reload Integration, or log out and back in once."
                )
            else:
                self._message(f"SessionSifu extension is unavailable: {error.message}")
            return None

    def _enable_extension(self, _button) -> None:
        ok, message = enable_extension()
        if ok:
            self._message(message or "Extension enabled.")
        else:
            self._message(message or "Could not enable the extension. Log out and back in, then try again.")
        GLib.timeout_add(1200, self._refresh_once)

    def _refresh_once(self) -> bool:
        self.refresh()
        return GLib.SOURCE_REMOVE

    def _open_extension_preferences(self, _button) -> None:
        try:
