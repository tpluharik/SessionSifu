    def _show_detail(self, item: dict) -> None:
        self._detail_item = item
        self._detail_indices = recall_image_indices(item)
        preferred = recall_highlight_image_index(item)
        try:
            self._detail_position = self._detail_indices.index(int(preferred))
        except (TypeError, ValueError):
            self._detail_position = 0
        modified = datetime.fromtimestamp(
            item.get("modified", 0)
        ).strftime("%Y-%m-%d %H:%M:%S")
        apps = ", ".join(item.get("apps", [])[:4]) or "Unknown application"
        titles = " · ".join(item.get("titles", [])[:2])
        self.detail_heading.set_label(titles or apps)
        self.detail_meta.set_label(
            f"{apps} · {modified} · "
            f"{self._match_description(str(item.get('match_type', 'Timeline')))} · "
            f"{recall_capture_summary(item)}"
        )
        self._clear_box(self.detail_filmstrip)
        for position, image_index in enumerate(self._detail_indices):
            window = self._window_for_image(item, image_index)
            label = str(window.get("app") or window.get("title") or "Display") if window else "Display"
            button = Gtk.Button(tooltip_text=str(window.get("title") or label) if window else "Display overview")
            thumbnail = item.get("_pixbuf_by_index", {}).get(image_index)
            tile = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
            if thumbnail is not None:
                picture = Gtk.Picture.new_for_paintable(Gdk.Texture.new_for_pixbuf(thumbnail))
                picture.set_content_fit(Gtk.ContentFit.COVER)
                picture.set_size_request(128, 72)
                tile.append(picture)
            else:
                tile.append(Gtk.Image(icon_name="image-x-generic-symbolic", pixel_size=32))
            tile.append(Gtk.Label(label=label[:20], ellipsize=Pango.EllipsizeMode.END))
            button.set_child(tile)
            button.connect("clicked", lambda _button, value=position: self._set_detail_position(value))
            self.detail_filmstrip.append(button)
        self._set_detail_position(self._detail_position)

    @staticmethod
    def _window_for_image(item: dict, image_index: int) -> dict | None:
        for window in item.get("windows", []):
            if not isinstance(window, dict):
                continue
            try:
                if int(window.get("image_index", -1)) == image_index:
                    return window
            except (TypeError, ValueError):
                continue
        return None

    def _set_detail_position(self, position: int) -> None:
        if self._detail_item is None or not self._detail_indices:
            self.detail_picture.set_paintable(None)
            self.detail_state.set_label(self._empty_preview_state())
            return
        self._detail_position = max(0, min(len(self._detail_indices) - 1, position))
        image_index = self._detail_indices[self._detail_position]
        data = self._vault.preview_bytes(self._detail_item.get("name", ""), image_index)
        self._detail_pixbuf = _pixbuf_from_bytes(data) if data else None
        self.detail_picture.set_paintable(
            Gdk.Texture.new_for_pixbuf(self._detail_pixbuf)
            if self._detail_pixbuf is not None else None
        )
        highlighted = recall_highlight_image_index(self._detail_item)
        boxes = self._detail_item.get("highlight_boxes", []) if image_index == highlighted else []
        self._detail_match_position = 0
        self._detail_highlight_state.update(
            pixbuf=self._detail_pixbuf, boxes=boxes, pulse=1.0, active_index=0
        )
        self.detail_highlights.queue_draw()
        window = self._window_for_image(self._detail_item, image_index)
        if window:
            title = str(window.get("title") or window.get("app") or "Application window")
            state = "Exact application-window screenshot"
        else:
            title = "Display overview"
            state = "Display overview · useful for minimized or uncaptured windows"
        self.detail_state.set_label(
            f"{self._detail_position + 1} of {len(self._detail_indices)} · {title[:90]} · {state}"
        )
        self._update_match_controls()
        self._apply_zoom()

    def _empty_preview_state(self) -> str:
        if not self._settings.get_boolean("recall-capture-screenshots"):
            return "Screenshot capture is disabled; searchable metadata was captured."
        return "Metadata captured; this window was minimized, excluded, or unavailable to the compositor."

    def _step_detail(self, delta: int) -> None:
        if self._detail_indices:
            self._set_detail_position((self._detail_position + delta) % len(self._detail_indices))

    def _step_match(self, delta: int) -> None:
        boxes = self._detail_highlight_state.get("boxes") or []
        if not boxes:
            return
        self._detail_match_position = (self._detail_match_position + delta) % len(boxes)
        self._detail_highlight_state["active_index"] = self._detail_match_position
        self._update_match_controls()
        self._pulse_match()
        self._center_match()

    def _update_match_controls(self) -> None:
        count = len(self._detail_highlight_state.get("boxes") or [])
        self.match_counter.set_label(
            f"Match {self._detail_match_position + 1} of {count}" if count else "No OCR match"
        )
        self.match_previous.set_sensitive(count > 1)
        self.match_next.set_sensitive(count > 1)

    def _pulse_match(self) -> None:
        started = time.monotonic()

        def animate() -> bool:
            elapsed = time.monotonic() - started
            self._detail_highlight_state["pulse"] = 0.35 + 0.65 * abs(__import__("math").cos(elapsed * 8))
            self.detail_highlights.queue_draw()
            return elapsed < 0.9

        GLib.timeout_add(70, animate)

    def _effective_zoom(self) -> float:
        if self._detail_zoom > 0:
            return self._detail_zoom
        pixbuf = self._detail_pixbuf
        if pixbuf is None:
            return 1.0
        width = max(1, self.detail_scroller.get_width() - 8)
        height = max(1, self.detail_scroller.get_height() - 8)
        return min(width / pixbuf.get_width(), height / pixbuf.get_height(), 1.0)

    def _scroll_center(self) -> tuple[float, float]:
        def center(adjustment: Gtk.Adjustment) -> float:
            upper = max(adjustment.get_upper(), adjustment.get_page_size(), 1.0)
            return max(
                0.0,
                min(
                    1.0,
                    (adjustment.get_value() + adjustment.get_page_size() / 2) / upper,
                ),
            )

        return (
            center(self.detail_scroller.get_hadjustment()),
            center(self.detail_scroller.get_vadjustment()),
        )

    def _restore_scroll_center(self, anchor: tuple[float, float]) -> bool:
        for ratio, adjustment in zip(
            anchor,
            (
                self.detail_scroller.get_hadjustment(),
                self.detail_scroller.get_vadjustment(),
            ),
        ):
            target = ratio * adjustment.get_upper() - adjustment.get_page_size() / 2
            maximum = max(0.0, adjustment.get_upper() - adjustment.get_page_size())
            adjustment.set_value(max(0.0, min(maximum, target)))
        return GLib.SOURCE_REMOVE

    def _set_zoom(self, value: float, *, center_match: bool = False) -> None:
        anchor = self._scroll_center()
        self._detail_zoom = 0.0 if value <= 0 else max(0.25, min(4.0, value))
        self._apply_zoom()
        GLib.idle_add(self._restore_scroll_center, anchor)
        if center_match and self._detail_zoom > 1.0:
            self._center_match()

    def _zoom_gesture_begin(self, _gesture, _sequence) -> None:
        self._pinch_start_zoom = self._effective_zoom()

    def _zoom_gesture_changed(self, _gesture, scale: float) -> None:
        self._set_zoom(self._pinch_start_zoom * float(scale))

    def _touchpad_scroll(self, controller, dx: float, dy: float) -> bool:
        state = controller.get_current_event_state()
        if not state & Gdk.ModifierType.CONTROL_MASK:
            # Let GtkScrolledWindow retain smooth, kinetic two-finger panning.
            return False
        delta = dy if abs(dy) >= abs(dx) else dx
        if abs(delta) < 0.001:
            return False
        self._set_zoom(self._effective_zoom() * math.exp(-float(delta) * 0.12))
        return True

    def _apply_zoom(self) -> None:
        pixbuf = self._detail_pixbuf
        if pixbuf is None or self._detail_zoom <= 0:
            self.detail_picture.set_size_request(-1, -1)
            return
        self.detail_picture.set_size_request(
            max(1, round(pixbuf.get_width() * self._detail_zoom)),
            max(1, round(pixbuf.get_height() * self._detail_zoom)),
        )

    def _center_match(self) -> None:
        boxes = self._detail_highlight_state.get("boxes") or []
        if not boxes:
            return
        box = boxes[self._detail_match_position]

        def center() -> bool:
            try:
                horizontal = self.detail_scroller.get_hadjustment()
                vertical = self.detail_scroller.get_vadjustment()
                x = (float(box["x"]) + float(box["w"]) / 2) / 10000
                y = (float(box["y"]) + float(box["h"]) / 2) / 10000
                horizontal.set_value(max(0, x * horizontal.get_upper() - horizontal.get_page_size() / 2))
                vertical.set_value(max(0, y * vertical.get_upper() - vertical.get_page_size() / 2))
            except (KeyError, TypeError, ValueError):
                pass
            return GLib.SOURCE_REMOVE

        GLib.idle_add(center)

    def _key_pressed(self, _controller, keyval: int, _keycode: int, state) -> bool:
        if keyval in (Gdk.KEY_Left, Gdk.KEY_Up):
            self._step_detail(-1)
            return True
        if keyval in (Gdk.KEY_Right, Gdk.KEY_Down):
            self._step_detail(1)
            return True
        if keyval in (Gdk.KEY_plus, Gdk.KEY_equal):
            self._set_zoom(min(3.0, max(1.0, self._detail_zoom or 1.0) + 0.25))
            return True
        if keyval == Gdk.KEY_minus:
            self._set_zoom(max(0.5, (self._detail_zoom or 1.0) - 0.25))
            return True
        if keyval == Gdk.KEY_0:
            self._set_zoom(1.0)
            return True
        if keyval in (Gdk.KEY_space, Gdk.KEY_Return) and self._detail_item:
            if keyval == Gdk.KEY_Return:
                self._open_item(None, self._detail_item)
            else:
                self._view_item(None, self._detail_item)
            return True
        return False

    def _selected_day(self) -> str:
        selected = self.date_filter.get_active_id() or ""
        now = datetime.now()
        if selected == "today":
            return now.strftime("%Y-%m-%d")
        if selected == "yesterday":
            return (now - timedelta(days=1)).strftime("%Y-%m-%d")
        return ""

    def _show_all(self, *_args) -> None:
        self.query.set_text("")
        self.app_filter.set_active_id("")
        self.date_filter.set_active_id("")
        self._search_now()

    def _schedule_search(self, *_args) -> None:
        if self._search_timeout:
            GLib.source_remove(self._search_timeout)
        self._search_timeout = GLib.timeout_add(250, self._run_scheduled_search)

    def _run_scheduled_search(self) -> bool:
        self._search_timeout = 0
        self._search()
        return GLib.SOURCE_REMOVE

    def _search_now(self, *_args) -> None:
        if self._search_timeout:
            GLib.source_remove(self._search_timeout)
            self._search_timeout = 0
        self._search()

    def _search(self, *_args) -> None:
        policy = recall_policy(self._settings)
        self._search_generation += 1
        request = {
            "generation": self._search_generation,
            "policy": policy,
            "query": self.query.get_text(),
            "app": self.app_filter.get_active_id() or "",
            "day": self._selected_day(),
            "week": (self.date_filter.get_active_id() or "") == "week",
            "group": self.group_scenes.get_active(),
            "excluded_apps": tuple(self._settings.get_strv("recall-excluded-apps")),
        }
        self._pending_search = request
        self.notice.set_label("Searching encrypted local history…")
        if not self._search_inflight:
            self._start_pending_search()

    def _start_pending_search(self) -> None:
        request = self._pending_search
        if request is None:
            return
        self._pending_search = None
        self._search_inflight = True

        def worker() -> None:
            error = ""
            try:
                self._vault.migrate_legacy(request["policy"])
                entries = self._vault.search(
                    request["query"], app=request["app"], day=request["day"],
                    semantic=request["policy"].semantic,
                    excluded_apps=request["excluded_apps"],
                )
                if request["group"] and not request["query"].strip() and not request["app"]:
                    entries = self._vault.group_scenes(entries)
            except (OSError, RuntimeError, ValueError) as caught:
                entries = []
                error = str(caught)[:512]
            GLib.idle_add(self._finish_search, request, entries, error)

        threading.Thread(target=worker, name="sessionsifu-recall-search", daemon=True).start()

    def _finish_search(self, request: dict, entries: list[dict], error: str) -> bool:
        self._search_inflight = False
        if request["generation"] == self._search_generation:
            self._apply_search_results(entries, week=request["week"])
            if error:
                self.notice.set_label(f"Recall vault unavailable: {error}")
        if self._pending_search is not None:
            self._start_pending_search()
        return GLib.SOURCE_REMOVE

    def _apply_search_results(self, entries: list[dict], *, week: bool) -> None:
        if week:
            cutoff = time.time() - 7 * 86400
            entries = [entry for entry in entries if float(entry.get("modified") or 0) >= cutoff]
        self._render_limit = 24
        self._entries = entries
        self.timeline_scale.set_range(0, max(1, len(entries) - 1))
        self.timeline_scale.set_value(0)
        known_apps = sorted({app for entry in entries for app in entry.get("apps", [])}, key=str.casefold)
        active_app = self.app_filter.get_active_id() or ""
        if tree_model_row_count(self.app_filter.get_model()) <= 1 and known_apps:
            for app in known_apps:
                self.app_filter.append(app, app)
            self.app_filter.set_active_id(active_app)
        self._render(entries)

    def _load_more_results(self, *_args) -> None:
        self._render_limit = min(len(self._entries), self._render_limit + 24)
        self._render(self._entries)

    @staticmethod
    def _match_description(match_type: str) -> str:
        return {
            "Window image text": "Found in this screenshot",
            "Visual text": "Found in a display screenshot",
            "Window text": "Found in the window title",
            "Window file": "Found in an open file",
            "Application": "Found in the application name",
            "Timeline": "Saved moment",
        }.get(match_type, "Matching saved moment")

    def _more_button(self, item: dict) -> Gtk.MenuButton:
        popover = Gtk.Popover()
        menu = Gtk.Box(
            orientation=Gtk.Orientation.VERTICAL, spacing=4,
            margin_top=8, margin_bottom=8, margin_start=8, margin_end=8,
        )

        def add(label: str, callback, argument: object = item, *, destructive: bool = False) -> None:
            button = Gtk.Button(label=label, halign=Gtk.Align.FILL)
            if destructive:
                button.add_css_class("destructive-action")
            button.connect("clicked", callback, argument)
            menu.append(button)

        if item.get("image_count"):
            add("Copy screenshot", self._copy_image)
        add("Copy recognized text", self._copy_item)
        add("Bookmark / unbookmark", self._bookmark_item)
        add("Collection and note…", self._annotate_item)
        add("Reindex OCR for this moment", self._reindex_item)
        add("Show OCR diagnostics", self._ocr_diagnostics)
        add("Delete this moment", self._delete_item, destructive=True)
        if item.get("apps"):
            add(
                f"Delete all from {item['apps'][0]}", self._delete_app,
                item["apps"][0], destructive=True,
            )
        if item.get("urls"):
            domain = urllib.parse.urlparse(item["urls"][0]).hostname or item["urls"][0]
            add(f"Delete all from {domain}", self._delete_website, domain, destructive=True)
        add(
            "Delete moments before this", self._delete_earlier,
            float(item.get("modified") or 0), destructive=True,
        )
        popover.set_child(menu)
        more = Gtk.MenuButton(label="More")
        more.set_popover(popover)
        return more

    def _render(self, entries: list[dict]) -> None:
        self._render_generation += 1
        render_generation = self._render_generation
        for row in self._rows:
            self.results.remove(row)
        self._rows.clear()
        visible_entries = entries[:self._render_limit]
        for item in visible_entries:
            modified = datetime.fromtimestamp(item.get("modified", 0)).strftime("%Y-%m-%d %H:%M:%S")
            apps = ", ".join(item.get("apps", [])[:4]) or "Unknown application"
            titles = " · ".join(item.get("titles", [])[:3])
            row = Gtk.Box(
                orientation=Gtk.Orientation.HORIZONTAL,
                spacing=14,
                margin_top=10,
                margin_bottom=10,
                margin_start=10,
                margin_end=10,
            )
            row.add_css_class("card")
            if self._view_mode == "visual":
                preview_slot = Gtk.Box()
                preview_slot.append(Gtk.Spinner(
                    spinning=True, width_request=190, height_request=108,
                ))
                row.append(preview_slot)

                def prepare_preview(
                    target: dict = item, slot: Gtk.Box = preview_slot,
                    generation: int = render_generation,
                ) -> None:
                    self._prepare_previews(target)
                    GLib.idle_add(self._finish_preview, target, slot, generation)

                self._preview_executor.submit(prepare_preview)
            body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=7, hexpand=True)
            if item.get("result_kind") == "window":
                heading = f"{apps} — {titles}" if titles else apps
            else:
                heading = f"{modified} — {apps}"
            title = Gtk.Label(
                label=heading,
                xalign=0,
                wrap=True,
            )
            title.add_css_class("heading")
            body.append(title)
            match_type = str(item.get("match_type", "Timeline"))
            match = Gtk.Label(
                label=(
                    f"{self._match_description(match_type)} · {modified} · "
                    f"{recall_capture_summary(item)}"
                ),
                xalign=0,
            )
            match.add_css_class("caption")
            body.append(match)
            details = Gtk.Label(
                label=item.get("ocr_excerpt") or titles or "No searchable text was exposed",
                xalign=0,
                wrap=True,
                lines=2 if self._view_mode == "visual" else 1,
                ellipsize=Pango.EllipsizeMode.END,
            )
            details.add_css_class("dim-label")
            body.append(details)
            actions = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
            if item.get("targets") or item.get("matched_window", {}).get("app_id"):
                open_button = Gtk.Button(label="Open")
                open_button.add_css_class("suggested-action")
                open_button.connect("clicked", self._open_item, item)
                actions.append(open_button)
            if item.get("image_count"):
                window_previews = len(recall_window_image_indices(item))
                view_button = Gtk.Button(
                    label=(
                        f"View {window_previews} screenshots"
                        if window_previews > 1 else "View screenshot"
                    )
                )
                view_button.connect("clicked", self._view_item, item)
                actions.append(view_button)
            actions.append(self._more_button(item))
            body.append(actions)
            row.append(body)
            gesture = Gtk.GestureClick()
            gesture.connect("pressed", self._select_item, item)
            row.add_controller(gesture)
            self.results.insert(row, -1)
            self._rows.append(row)
        self.load_more.set_visible(len(entries) > len(visible_entries))
        if len(entries) > len(visible_entries):
            self.load_more.set_label(
                f"Load 24 more results · showing {len(visible_entries)} of {len(entries)}"
            )
        status = self._vault.status()
        result_label = (
            "window moment"
            if entries and all(item.get("result_kind") == "window" for item in entries)
            else "Recall result"
        )
        self.notice.set_label(
            f"{len(entries)} {result_label}{'s' if len(entries) != 1 else ''}"
            " matched · "
            f"{status.get('vault_bytes', 0) / (1024 * 1024):.1f} MiB · "
            f"encryption: {status.get('encryption', 'unavailable')}"
            if entries
            else "No matching encrypted Recall snapshots. Check Capture diagnostics in SessionSifu."
        )
        if entries:
            selected_name = self._detail_item.get("name") if self._detail_item else ""
            selected = next(
                (item for item in entries if item.get("name") == selected_name), entries[0]
            )
            self._show_detail(selected)
        else:
            self._detail_item = None
            self._detail_indices = []
            self.detail_heading.set_label("No saved moment selected")
            self.detail_meta.set_label("Try a broader search or check Capture diagnostics.")
            self.detail_picture.set_paintable(None)
            self.detail_state.set_label(self._empty_preview_state())
            self._clear_box(self.detail_filmstrip)

    def _finish_preview(
        self, item: dict, slot: Gtk.Box, generation: int
    ) -> bool:
        if generation != self._render_generation or slot.get_parent() is None:
            return GLib.SOURCE_REMOVE
        self._clear_box(slot)
        preview = recall_preview(item, width=190, height=108, show_all=False)
        preview.set_size_request(190, 108)
        slot.append(preview)
        if (
            self._detail_item
            and self._detail_item.get("name") == item.get("name")
        ):
            self._show_detail(item)
        return GLib.SOURCE_REMOVE

    def _timeline_changed(self, scale) -> None:
        if self._entries:
            index = max(0, min(len(self._entries) - 1, round(scale.get_value())))
            self._show_detail(self._entries[index])

    def _ask_history(self, *_args) -> None:
        question = self.query.get_text().strip()
        if not question:
            self.notice.set_label("Type a question in Search, then choose Ask history.")
            self.query.grab_focus()
            return
        try:
            result = self._vault.ask(question)
            citations = "\n".join(
                f"• {item.get('captured_at', '')} · {item.get('application', '')} · {item.get('title', '')}"
                for item in result.get("citations", [])
            )
            dialog = Adw.MessageDialog.new(
                self, "Answer from local history",
                f"{result.get('answer', '')}\n\nEvidence:\n{citations}",
            )
            dialog.add_response("close", "Close")
            dialog.present()
        except (OSError, RuntimeError, ValueError) as error:
            self.notice.set_label(f"Local history answer failed: {error}")

    def _bookmark_item(self, _button, item: dict) -> None:
        current = bool(dict(item.get("annotations") or {}).get("bookmarked"))
        self._vault.annotate(str(item.get("name") or ""), bookmarked=not current)
        self._search()

    def _annotate_item(self, _button, item: dict) -> None:
        annotations = dict(item.get("annotations") or {})
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        collection = Gtk.Entry(placeholder_text="Collection")
        collection.set_text(str(annotations.get("collection") or ""))
        note = Gtk.Entry(placeholder_text="Private local note")
        note.set_text(str(annotations.get("note") or ""))
        box.append(collection)
        box.append(note)
        dialog = Adw.MessageDialog.new(self, "Organize this saved moment", "Bookmarks, collections and notes remain encrypted locally.")
        dialog.set_extra_child(box)
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("save", "Save")
        dialog.set_response_appearance("save", Adw.ResponseAppearance.SUGGESTED)

        def response(_dialog, choice: str) -> None:
            if choice == "save":
                self._vault.annotate(
                    str(item.get("name") or ""),
                    collection=collection.get_text(), note=note.get_text(),
                )
                self._search()

        dialog.connect("response", response)
        dialog.present()

    def _reindex_item(self, _button, item: dict) -> None:
        try:
            result = self._vault.reindex(str(item.get("name") or ""))
            self.notice.set_label(
                f"OCR reindex complete: {result.get('images_indexed', 0)} images, "
                f"{result.get('recognized_characters', 0)} recognized characters."
            )
            self._search()
        except (OSError, RuntimeError, ValueError) as error:
            self.notice.set_label(f"OCR reindex failed: {error}")

    def _ocr_diagnostics(self, _button, item: dict) -> None:
        diagnostics = dict(item.get("ocr_diagnostics") or {"state": "not-indexed"})
        dialog = Adw.MessageDialog.new(
            self, "OCR diagnostics", json.dumps(diagnostics, indent=2),
        )
        dialog.add_response("close", "Close")
        dialog.present()

    def _open_item(self, _button, item: dict) -> None:
        target = next(iter(item.get("targets", [])), "")
        match = item.get("matched_window") or {}
        app_id = str(match.get("app_id") or "")
        app_info = None
        if app_id:
            candidates = (app_id, f"{app_id}.desktop")
            app_info = next(
                (
                    value for candidate in candidates
                    for value in [Gio.DesktopAppInfo.new(candidate)] if value
                ),
                None,
            )
        if target:
            if app_info is not None:
                try:
                    app_info.launch([Gio.File.new_for_uri(target)], None)
                    return
                except GLib.Error:
                    pass
            Gio.AppInfo.launch_default_for_uri(target, None)
        elif app_info is not None:
            app_info.launch([], None)

    def _copy_item(self, _button, item: dict) -> None:
        text = item.get("ocr_excerpt") or "\n".join(item.get("titles", []))
        display = Gdk.Display.get_default()
        if display and text:
            display.get_clipboard().set_text(str(text))

    def _delete_item(self, _button, item: dict) -> None:
        self._vault.delete(record=item.get("name", ""))
        self._search()

    def _delete_app(self, _button, app: str) -> None:
        self._vault.delete(app=app)
        self._search()

    def _delete_website(self, _button, website: str) -> None:
        self._vault.delete(website=website)
        self._search()

    def _delete_earlier(self, _button, timestamp: float) -> None:
        self._vault.delete(before=timestamp)
        self._search()

    def _copy_image(self, _button, item: dict) -> None:
        pixbuf = item.get("_window_pixbuf")
        if pixbuf is None:
            indices = recall_image_indices(item)
            data = self._vault.preview_bytes(
                item.get("name", ""), indices[0] if indices else 0
            )
            pixbuf = _pixbuf_from_bytes(data) if data else None
        display = Gdk.Display.get_default()
        if display and pixbuf is not None:
            display.get_clipboard().set_texture(Gdk.Texture.new_for_pixbuf(pixbuf))

    def _view_item(self, _button, item: dict) -> None:
        indices = recall_image_indices(item)
        if not indices:
            return
        viewer = Adw.Window(
            title="Recall Window Gallery",
            transient_for=self,
            modal=True,
            default_width=960,
            default_height=640,
        )
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        header = Adw.HeaderBar()
        box.append(header)
        picture = Gtk.Picture()
        picture.set_size_request(900, 540)
        picture.set_content_fit(Gtk.ContentFit.CONTAIN)
        picture.set_hexpand(True)
        picture.set_vexpand(True)
        overlay = Gtk.Overlay()
        overlay.set_child(picture)
        overlay.set_hexpand(True)
        overlay.set_vexpand(True)
        highlight_state = {"pixbuf": None, "boxes": []}
        highlight_layer = Gtk.DrawingArea()
        highlight_layer.set_can_target(False)
        highlight_layer.set_hexpand(True)
        highlight_layer.set_vexpand(True)
        highlight_layer.set_draw_func(
            _draw_ocr_highlights, highlight_state
        )
        overlay.add_overlay(highlight_layer)
        box.append(overlay)
        navigation = Gtk.Box(
            orientation=Gtk.Orientation.HORIZONTAL,
            spacing=12,
            halign=Gtk.Align.CENTER,
            margin_bottom=12,
        )
        previous_button = Gtk.Button(label="Previous")
        position_label = Gtk.Label()
        next_button = Gtk.Button(label="Next")
        navigation.append(previous_button)
        navigation.append(position_label)
        navigation.append(next_button)
        box.append(navigation)

        position = 0

        def show_image(next_position: int) -> None:
            nonlocal position
            position = max(0, min(len(indices) - 1, next_position))
            image_index = indices[position]
            data = self._vault.preview_bytes(item.get("name", ""), image_index)
            pixbuf = _pixbuf_from_bytes(data) if data else None
            picture.set_paintable(
                Gdk.Texture.new_for_pixbuf(pixbuf) if pixbuf is not None else None
            )
            highlight_state["pixbuf"] = pixbuf
            match = item.get("matched_window")
            try:
                matched_image_index = int(match.get("image_index", -1))
            except (AttributeError, TypeError, ValueError):
                matched_image_index = -1
            try:
                highlighted_image_index = int(
                    item.get("highlight_image_index", matched_image_index)
                )
            except (TypeError, ValueError):
                highlighted_image_index = matched_image_index
            highlight_state["boxes"] = (
                item.get("highlight_boxes", [])
                if image_index == highlighted_image_index else []
            )
            highlight_layer.queue_draw()
            window = None
            for candidate in item.get("windows", []):
                if not isinstance(candidate, dict):
                    continue
                try:
                    candidate_index = int(candidate.get("image_index", -1))
                except (TypeError, ValueError):
                    continue
                if candidate_index == image_index:
                    window = candidate
                    break
            if window:
                description = str(
                    window.get("title") or window.get("app") or "Application window"
                )
            else:
                description = "Display overview"
            position_label.set_label(
                f"{position + 1} of {len(indices)} — {description[:80]}"
            )
            previous_button.set_sensitive(position > 0)
            next_button.set_sensitive(position + 1 < len(indices))

        previous_button.connect("clicked", lambda *_args: show_image(position - 1))
        next_button.connect("clicked", lambda *_args: show_image(position + 1))
        viewer.set_content(box)
        self._recall_viewer = viewer
        show_image(0)
        viewer.present()

    def present_search(self) -> None:
        self.present()
        self.query.grab_focus()
        self.query.select_region(0, -1)


