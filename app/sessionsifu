def missing_user_payload_modules() -> tuple[str, ...]:
    """Return modules omitted by a legacy user-local updater.

    System packages keep modules in ``/usr/lib/sessionsifu``.  User updates
    place the launcher and modules together, so the presence of a sibling
    Recall engine identifies that layout without relying on a home-directory
    string comparison.
    """
    app_directory = Path(__file__).resolve().parent
    if not (app_directory / "recall_engine.py").is_file():
        return ()
    support_names = ("semantic.py", "restore_journal.py", "mcp.py", "capsule.py")
    if all((_portable_module_dir / name).is_file() for name in support_names):
        return ()
    return tuple(
        name
        for name in support_names
        if not (app_directory / name).is_file()
    )


