    def _pause_recall(self, _button, seconds: int) -> None:
        now = int(time.time())
        if seconds == -2:
            tomorrow = datetime.now().replace(hour=0, minute=0, second=0, microsecond=0) + timedelta(days=1)
            until = int(tomorrow.timestamp())
        elif seconds < 0:
            until = -1
        elif seconds == 0:
            until = 0
        else:
            until = now + seconds
        self._settings.set_int64("recall-pause-until", until)
        self._message("Privacy Recall resumed." if until == 0 else "Privacy Recall capture paused; existing history remains searchable.")
        self._refresh_recall_diagnostics()

    def _refresh_recall_diagnostics(self, *_args) -> None:
        status = recall_vault().status()
        state = str(status.get("state", "unknown"))
        duration = status.get("duration_ms")
        screenshots = status.get("screenshots", 0)
        size = float(status.get("vault_bytes", 0)) / (1024 * 1024)
        detail = f"{state} · {screenshots} preview(s) · {size:.1f} MiB · {status.get('encryption', 'unavailable')}"
        if duration is not None:
            detail += f" · {duration} ms"
        if status.get("reason"):
            detail += f" · {status['reason']}"
        self.recall_diagnostics_row.set_subtitle(detail)

