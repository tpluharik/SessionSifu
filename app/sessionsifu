    def _prepare_previews(self, item: dict) -> None:
        if item.get("_pixbuf_by_index"):
            return
        pixbufs = []
        pixbuf_by_index = {}
        image_count = int(item.get("image_count") or 0)
        indices = []
        try:
            highlighted = int(item.get("highlight_image_index", -1))
        except (TypeError, ValueError):
            highlighted = -1
        if 0 <= highlighted < image_count:
            indices.append(highlighted)
        match = item.get("matched_window")
        if isinstance(match, dict):
            try:
                window_image_index = int(match.get("image_index", -1))
            except (TypeError, ValueError):
                window_image_index = -1
            if 0 <= window_image_index < image_count:
                indices.append(window_image_index)
        if image_count and not indices:
            indices.append(0)
        for index in dict.fromkeys(indices[:1]):
            data = self._vault.preview_bytes(item["name"], index)
            pixbuf = self._pixbuf(data) if data else None
            if pixbuf is not None:
                width, height = pixbuf.get_width(), pixbuf.get_height()
                scale = min(1.0, 320 / max(1, width), 180 / max(1, height))
                if scale < 1.0:
                    scaled = pixbuf.scale_simple(
                        max(1, round(width * scale)), max(1, round(height * scale)),
                        GdkPixbuf.InterpType.BILINEAR,
                    )
                    if scaled is not None:
                        pixbuf = scaled
                pixbufs.append(pixbuf)
                pixbuf_by_index[index] = pixbuf
        item["_pixbufs"] = pixbufs
        item["_pixbuf_by_index"] = pixbuf_by_index
        item["_window_pixbuf"] = _window_pixbuf(item)

