    def _message(self, text: str) -> None:
        self.banner.set_title(text)
        self.banner.set_revealed(True)

    def _call(self, method: str, parameters: GLib.Variant | None = None) -> str | None:
        try:
            result = call(method, parameters)
            self._message(result)
            return result
        except GLib.Error as error:
            self._message(f"SessionSifu extension is unavailable: {error.message}")
            return None

    def _enable_extension(self, _button) -> None:
        ok, message = enable_extension()
        if ok:
            self._message(message or "Extension enabled.")
        else:
            self._message(message or "Could not enable the extension. Log out and back in, then try again.")
        GLib.timeout_add(1200, self._refresh_once)

    def _refresh_once(self) -> bool:
        self.refresh()
        return GLib.SOURCE_REMOVE

    def _open_extension_preferences(self, _button) -> None:
        try:
            subprocess.Popen(["gnome-extensions", "prefs", UUID])
        except OSError as error:
            self._message(str(error))

    def _save(self, _widget) -> None:
        name = self.name_entry.get_text().strip()
        if not NAME_RE.fullmatch(name) or name == "backups":
            self._message("Use 1–64 letters, numbers, spaces, dots, underscores or hyphens.")
            return
        if self._call("SaveSession", GLib.Variant("(s)", (name,))):
            self.name_entry.set_text("")
            GLib.timeout_add(900, self._refresh_once)

    def _restore(self, _button, name: str) -> None:
        self._call("RestoreSession", GLib.Variant("(s)", (name,)))

    def _delete(self, _button, name: str) -> None:
        dialog = Adw.AlertDialog(
            heading="Delete saved session?",
            body=f"“{name}” will be moved to Trash.",
        )
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("delete", "Delete")
        dialog.set_response_appearance("delete", Adw.ResponseAppearance.DESTRUCTIVE)
        dialog.set_default_response("cancel")
        dialog.set_close_response("cancel")
        dialog.connect("response", self._delete_response, name)
        dialog.present(self)

    def _delete_response(self, _dialog, response: str, name: str) -> None:
        if response == "delete" and self._call("DeleteSession", GLib.Variant("(s)", (name,))):
            self.refresh()

    def _toggle_restore(self, row, _param) -> None:
        enabled = row.get_active()
        self._settings.set_boolean("enable-restore-previous-session", enabled)
        if enabled:
            self._settings.set_boolean("enable-autorestore-sessions", False)

    def _toggle_indicator(self, row, _param) -> None:
        self._settings.set_boolean("show-indicator", row.get_active())

    def _toggle_continuous_save(self, row, _param) -> None:
        enabled = row.get_active()
        self._settings.set_boolean("continuous-save-enabled", enabled)
        self.snapshot_interval_row.set_sensitive(enabled)

    def _snapshot_interval_changed(self, row, _param) -> None:
        selected = row.get_selected()
        if selected < len(self.snapshot_intervals):
            self._settings.set_int("continuous-save-interval", self.snapshot_intervals[selected])

    def _save_snapshot(self, _button) -> None:
        self._call("SaveHistoryNow")
        GLib.timeout_add(1400, self._refresh_once)

    def _restore_history(self, _button, name: str) -> None:
        self._call("RestoreHistory", GLib.Variant("(s)", (name,)))

    def _session_rows(self) -> list[dict]:
        try:
            return json.loads(call("ListSessions"))
        except (GLib.Error, json.JSONDecodeError):
            return []

    def _history_rows(self) -> list[dict]:
        try:
            return json.loads(call("ListHistory"))
        except (GLib.Error, json.JSONDecodeError):
            return []

    def _update_clicked(self, _button) -> None:
        if self._installed_update is not None and self._installed_update.is_file():
            try:
                subprocess.Popen(
                    [
                        "/bin/sh",
                        "-c",
                        'sleep 1; exec "$1"',
                        "sessionsifu-restart",
                        str(self._installed_update),
                    ],
                    start_new_session=True,
                )
                self.get_application().quit()
            except OSError as error:
                self._message(f"Could not restart SessionSifu: {error}")
            return
        if self._available_update is not None:
            self._download_available_update()
            return
        self.update_button.set_sensitive(False)
        self.update_row.set_subtitle("Checking the SessionSifu GitHub repository…")

        def worker() -> None:
            try:
                manifest = fetch_update_manifest()
                GLib.idle_add(self._finish_update_check, manifest, None)
            except Exception as error:
                GLib.idle_add(self._finish_update_check, None, str(error))

        threading.Thread(target=worker, daemon=True).start()

    def _finish_update_check(self, manifest: dict | None, error: str | None) -> bool:
        self.update_button.set_sensitive(True)
        if error:
            self.update_row.set_subtitle(f"Update check failed: {error}")
            self.update_button.set_label("Try Again")
            self.update_button.remove_css_class("suggested-action")
            return GLib.SOURCE_REMOVE
        if version_tuple(manifest["version"]) <= version_tuple(CURRENT_VERSION):
            self.update_row.set_subtitle(f"Version {CURRENT_VERSION} is current")
            self.update_button.set_label("Check Again")
            self.update_button.remove_css_class("suggested-action")
            return GLib.SOURCE_REMOVE

        self._available_update = manifest
        notes = manifest["notes"] or "A newer verified package is available."
        self.update_row.set_subtitle(f"Version {manifest['version']} available · {notes}")
        self.update_button.set_label("Download & Install")
        self.update_button.add_css_class("suggested-action")
        return GLib.SOURCE_REMOVE

    def _download_available_update(self) -> None:
        manifest = self._available_update
        self.update_button.set_sensitive(False)
        self.update_row.set_subtitle(f"Downloading and verifying version {manifest['version']}…")

        def worker() -> None:
            try:
                package = download_update(manifest)
                local_app = install_user_update(package, manifest["version"])
                GLib.idle_add(self._finish_update_download, local_app, None)
            except Exception as error:
                GLib.idle_add(self._finish_update_download, None, str(error))

        threading.Thread(target=worker, daemon=True).start()

    def _finish_update_download(self, local_app: Path | None, error: str | None) -> bool:
        self.update_button.set_sensitive(True)
        if error:
            self.update_row.set_subtitle(f"Update failed: {error}")
            self.update_button.set_label("Try Again")
            self._available_update = None
            self.update_button.remove_css_class("suggested-action")
            return GLib.SOURCE_REMOVE

        self._installed_update = local_app
        self._available_update = None
        self.update_row.set_subtitle(
            "Installed for this user; restart the app, then log out and back in once"
        )
        self.update_button.set_label("Restart SessionSifu")
        self._message("SessionSifu was updated without using the system package manager.")
        return GLib.SOURCE_REMOVE

    def refresh(self) -> None:
        for child in self._session_rows_widgets:
            self.sessions_group.remove(child)
        self._session_rows_widgets.clear()
        for child in self._history_rows_widgets:
            self.history_group.remove(child)
        self._history_rows_widgets.clear()

        ping_message = None
        try:
            ping_message = call("Ping")
        except GLib.Error:
            pass
        live = ping_message is not None
        integration_current = ping_message == f"SessionSifu {CURRENT_VERSION} is ready"

        state, _state_message = extension_state()
        integration_update = extension_needs_update()
        self.status_row.set_subtitle(
            "Update GNOME integration, then log out and back in" if integration_update else
            "Integration updated; log out and back in to load it" if live and not integration_current else
            "Enabled and connected" if live else
            "Enabled; starting GNOME integration" if state == "enabled" else
            "Installed but not enabled" if state == "disabled" else
            "Installed; log out and back in once" if state == "pending" else
            "Ready to install for this login" if state == "missing" else
            "GNOME extension manager is unavailable"
        )
        self.status_icon.set_from_icon_name(
            "emblem-ok-symbolic" if live and integration_current else "dialog-warning-symbolic"
        )
        self.enable_button.set_visible(
            integration_update or (not live and state != "pending")
        )
        self.enable_button.set_label(
            "Update Integration" if integration_update else
            "Install & Enable" if state == "missing" else "Enable"
        )
        self.enable_button.set_sensitive(state != "unavailable")

        history = self._history_rows() if live and integration_current else []
        if not history:
            row = Adw.ActionRow(
                title="No automatic snapshots yet" if integration_current else "Update the GNOME integration to start history",
                subtitle="The first snapshot is created shortly after login." if integration_current else "The snapshot engine runs inside GNOME Shell.",
            )
            self.history_group.add(row)
            self._history_rows_widgets.append(row)
        else:
            for item in history:
                modified = datetime.fromtimestamp(item.get("modified", 0)).strftime("%Y-%m-%d %H:%M:%S")
                row = Adw.ActionRow(title=f"Snapshot from {modified}")
                restore = Gtk.Button(label="Restore", valign=Gtk.Align.CENTER)
                restore.add_css_class("suggested-action")
                restore.connect("clicked", self._restore_history, item["name"])
                row.add_suffix(restore)
                self.history_group.add(row)
                self._history_rows_widgets.append(row)

        sessions = self._session_rows() if live else []
        if not sessions:
            row = Adw.ActionRow(
                title="No saved sessions yet" if live else "Enable the extension to manage sessions",
                subtitle="Arrange your desktop and save it with a name." if live else "A one-time logout/login may be required after installation.",
            )
            self.sessions_group.add(row)
            self._session_rows_widgets.append(row)
            return

        for item in sessions:
            modified = datetime.fromtimestamp(item.get("modified", 0)).strftime("%Y-%m-%d %H:%M")
            row = Adw.ActionRow(title=item["name"], subtitle=f"Saved {modified}")
            restore = Gtk.Button(label="Restore", valign=Gtk.Align.CENTER)
            restore.add_css_class("suggested-action")
            restore.connect("clicked", self._restore, item["name"])
            delete = Gtk.Button(icon_name="user-trash-symbolic", tooltip_text="Move to Trash", valign=Gtk.Align.CENTER)
            delete.connect("clicked", self._delete, item["name"])
            row.add_suffix(restore)
            row.add_suffix(delete)
            self.sessions_group.add(row)
            self._session_rows_widgets.append(row)


class SessionSifuApplication(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.DEFAULT_FLAGS)

    def do_activate(self):
        window = self.get_active_window() or ManagerWindow(self)
        window.present()


def autostart() -> int:
    config = settings()
    if not config.get_boolean("enable-restore-previous-session"):
        return 0
    time.sleep(max(0, min(config.get_int("autostart-delay"), 60)))
    try:
        call("RestorePreviousSession", GLib.Variant("(a{sv})", ({"removeAfterRestore": GLib.Variant("b", False)},)), 15000)
        return 0
    except GLib.Error as error:
        print(f"sessionsifu: {error.message}", file=sys.stderr)
        return 1


def main() -> int:
    parser = argparse.ArgumentParser(description="Save and restore GNOME desktop sessions")
    parser.add_argument("--autostart", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("--save", metavar="NAME")
    parser.add_argument("--restore", metavar="NAME")
    parser.add_argument("--list", action="store_true")
    args = parser.parse_args()

    if args.autostart:
        return autostart()
    if args.save:
        print(call("SaveSession", GLib.Variant("(s)", (args.save,))))
        return 0
    if args.restore:
        print(call("RestoreSession", GLib.Variant("(s)", (args.restore,))))
        return 0
    if args.list:
        for item in json.loads(call("ListSessions")):
            print(item["name"])
        return 0

    app = SessionSifuApplication()
    return app.run([sys.argv[0]])


if __name__ == "__main__":
    raise SystemExit(main())
