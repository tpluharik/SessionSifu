    def _show_restore_preview(self, name: str, *, history: bool) -> None:
        plan_method = "PlanHistory" if history else "PlanSession"
        restore_method = "RestoreHistorySelection" if history else "RestoreSessionSelection"
        try:
            plan = json.loads(call(plan_method, GLib.Variant("(s)", (name,))))
        except (GLib.Error, json.JSONDecodeError) as error:
            self._message(
                "Could not preview this restore. Reload the GNOME integration once: "
                f"{error}"
            )
            return
        applications = plan.get("applications", []) if isinstance(plan, dict) else []
        if not applications:
            self._message(str(plan.get("error") or "This snapshot has no restorable applications."))
            return

        dialog = Adw.Dialog()
        dialog.set_title("Preview session restoration")
        dialog.set_content_width(620)
        dialog.set_content_height(min(640, 210 + len(applications) * 72))
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        root.append(Adw.HeaderBar())
        content = Gtk.Box(
            orientation=Gtk.Orientation.VERTICAL,
            spacing=12,
            margin_top=18,
            margin_bottom=18,
            margin_start=18,
            margin_end=18,
        )
        heading = Gtk.Label(
            label="Choose the applications to restore. Nothing is launched until you confirm.",
            wrap=True,
            xalign=0,
        )
        content.append(heading)
        rows = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
        rows.add_css_class("boxed-list")
        checks: list[tuple[Gtk.CheckButton, str]] = []
        for application in applications[:128]:
            identity = str(application.get("identity") or "")
            if not identity:
                continue
            documents = list(application.get("documents") or [])
            check = Gtk.CheckButton(
                label=(
                    f"{application.get('application') or 'Application'} — "
                    f"{application.get('windows', 0)} window(s)"
                    + (f" · {len(documents)} open file(s)" if documents else "")
                ),
                active=True,
                margin_top=12,
                margin_bottom=12,
                margin_start=12,
                margin_end=12,
            )
            check.set_tooltip_text("\n".join(str(value) for value in documents)[:4000])
            rows.append(check)
            checks.append((check, identity))
        scroller = Gtk.ScrolledWindow(vexpand=True, child=rows)
        scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        content.append(scroller)
        buttons = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12, halign=Gtk.Align.END)
        cancel = Gtk.Button(label="Cancel")
        confirm = Gtk.Button(label="Restore selected")
        confirm.add_css_class("suggested-action")
        cancel.connect("clicked", lambda _button: dialog.close())

        def confirm_restore(_button) -> None:
            selected = [identity for check, identity in checks if check.get_active()]
            if not selected:
                self._message("Select at least one application to restore.")
                return
            dialog.close()
            journal = restore_journal_store()
            journal_id = journal.begin(
                f"{'history' if history else 'named'}:{name}", applications,
            )
            try:
                result = self._call(
                    restore_method, GLib.Variant("(sas)", (name, selected)),
                )
                actions = [
                    {"identity": identity, "state": "requested" if result else "failed"}
                    for identity in selected
                ]
                journal.finish(
                    journal_id, actions=actions,
                    summary={"applications": len(selected), "extension_result": result or ""},
                    error="" if result else "GNOME integration did not confirm the restore",
                )
            except Exception as error:
                journal.finish(journal_id, actions=[], summary={}, error=str(error))
                raise

        confirm.connect("clicked", confirm_restore)
        buttons.append(cancel)
        buttons.append(confirm)
        content.append(buttons)
        root.append(content)
        dialog.set_child(root)
        dialog.present(self)

